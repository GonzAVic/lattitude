---
import ArrowIcon from "./ArrowIcon.astro";
import DrinkFeature from "./DrinkFeature.astro";
import {
  rideHero,
  rideDrinksSection,
  rideDrinks,
  rideProtein,
  rideClosing,
  localePath,
  type Locale,
} from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const hero = rideHero[lang];
const drinksSection = rideDrinksSection[lang];
const drinks = rideDrinks[lang];
const protein = rideProtein[lang];
const closing = rideClosing[lang];

const menuHref = `${localePath(lang)}#drinks`;
const mapsHref = "https://maps.app.goo.gl/Z8L3mJFAC32dR3XL7";
---

<section class="founders-hero">
  <div class="meta muted eyebrow">{hero.eyebrow}</div>
  <h1>{hero.heading}</h1>
  <p>{hero.subhead}</p>
  <div class="coord-strip" aria-hidden="true">
    {hero.micro.map((m) => <span>{m}</span>)}
  </div>
  <div class="statement-micro" aria-hidden="true">
    <img src="/micrographic-letsride.svg" alt="" />
  </div>
</section>

<section class="drinks">
  <div class="drinks-top">
    <div>
      <div class="meta muted" style="margin-bottom:18px">{drinksSection.eyebrow}</div>
      <h2>{drinksSection.heading}</h2>
    </div>
    <p>{drinksSection.body}</p>
  </div>

  <DrinkFeature drinks={drinks} />
</section>

<section class="founder-section center">
  <div class="meta muted eyebrow">{protein.eyebrow}</div>
  <h2>{protein.heading}</h2>
  <p>{protein.body}</p>
</section>

<section class="founders-closing">
  <h2>{closing.heading}</h2>
  <p>{closing.supporting}</p>
  <div class="hero-actions">
    <a class="btn hoverable" href={mapsHref} target="_blank" rel="noopener">{closing.ctaDirections} <ArrowIcon dir="up-right" /></a>
    <a class="btn hoverable" href={menuHref}>{closing.ctaMenu} <ArrowIcon dir="right" /></a>
  </div>
</section>
