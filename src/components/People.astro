---
import { people, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = people[lang];
---

<section class="people" id="people">
  <div class="people-grid">
    <div class="people-image">
      <img src="/images/1495474472287.webp" alt={t.alt} loading="lazy" />
      <div class="inside"><span class="pill">{t.pill}</span><span class="crosshair"><i></i></span></div>
    </div>
    <div class="people-copy">
      <h2>{t.heading}</h2>
      <p>{t.body}</p>
      <div class="people-tags meta">
        {t.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <div class="people-micro" aria-hidden="true">
        <span class="star"><i></i></span>
        <div>
          <div class="ruler"></div>
          <div class="meta" style="display:flex;justify-content:space-between;margin-top:9px;color:#888"><span>{t.arrive}</span><span>{t.leave}</span></div>
        </div>
        <span class="crosshair"><i></i></span>
      </div>
    </div>
  </div>
</section>
