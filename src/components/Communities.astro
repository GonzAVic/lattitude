---
import ArrowIcon from "./ArrowIcon.astro";
import {
  communitiesHero,
  communitiesIntro,
  communitiesList,
  communitiesCrossPromo,
  communitiesClosing,
  localePath,
  type Locale,
} from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const hero = communitiesHero[lang];
const intro = communitiesIntro[lang];
const list = communitiesList[lang];
const crossPromo = communitiesCrossPromo[lang];
const closing = communitiesClosing[lang];

const viewLabel = lang === "en" ? "View page" : "Ver página";
const activeLabel = lang === "en" ? "ACTIVE" : "ACTIVA";
---

<section class="founders-hero">
  <div class="meta muted eyebrow">{hero.eyebrow}</div>
  <h1>{hero.heading}</h1>
  <p>{hero.subhead}</p>
  <div class="coord-strip" aria-hidden="true">
    {hero.micro.map((m) => <span>{m}</span>)}
  </div>
</section>

<section class="founder-section center">
  <div class="meta muted eyebrow">{intro.eyebrow}</div>
  <h2>{intro.heading}</h2>
  {intro.body.map((p) => <p>{p}</p>)}
</section>

<section class="founder-section">
  <div class="communities-grid">
    {list.map((item) => (
      <div class="community-card">
        <div class="community-card-top">
          <span class="meta muted">{item.kind}</span>
          <span class="pill"><span class="dot"></span><span>{activeLabel}</span></span>
        </div>
        <h3>{item.name}</h3>
        <p class="community-tagline">{item.tagline}</p>
        <p class="muted">{item.body}</p>
        <div class="coord-strip" aria-hidden="true">
          {item.tags.map((t) => <span>{t}</span>)}
        </div>
        <div class="community-card-actions">
          <a class="btn hoverable" href={localePath(lang, `/${item.slug}`)}>{viewLabel} <ArrowIcon dir="right" /></a>
          {item.external && (
            <a class="btn hoverable" href={item.external.href} target="_blank" rel="noopener">{item.external.label} <ArrowIcon dir="up-right" /></a>
          )}
          {item.instagram && (
            <a class="btn hoverable" href={item.instagram} target="_blank" rel="noopener">Instagram <ArrowIcon dir="up-right" /></a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="lab communities-crosspromo">
  <div class="lab-grid">
    <div>
      <div class="meta muted" style="margin-bottom:18px">{crossPromo.eyebrow}</div>
      <h2>{crossPromo.heading}</h2>
      <p class="lab-note">{crossPromo.note}</p>
    </div>
    <div class="lab-list">
      {crossPromo.rows.map((row) => (
        <div class="lab-row">
          <strong>{row.title}</strong>
          <div class="mini">
            <span class="meta muted">{row.tag}</span>
            {row.icon === "star" && <span class="star"><i></i></span>}
            {row.icon === "crosshair" && <span class="crosshair"><i></i></span>}
            {row.icon === "arrow" && <ArrowIcon dir="up-right" />}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="founders-closing">
  <h2>{closing.heading}</h2>
  <p>{closing.supporting}</p>
  <div class="hero-actions">
    <a class="btn hoverable" href="https://www.instagram.com/lattitudecoffee" target="_blank" rel="noopener">{closing.ctaInstagram} <ArrowIcon dir="up-right" /></a>
  </div>
</section>
