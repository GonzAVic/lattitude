---
import ArrowIcon from "./ArrowIcon.astro";
import {
  communitiesHero,
  communitiesIntro,
  communitiesList,
  communitiesClosing,
  localePath,
  type Locale,
} from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const hero = communitiesHero[lang];
const intro = communitiesIntro[lang];
const list = communitiesList[lang];
const closing = communitiesClosing[lang];

const viewLabel = lang === "en" ? "See more" : "Ver más";
const activeLabel = lang === "en" ? "ACTIVE" : "ACTIVA";
---

<section class="founders-hero">
  <div class="meta muted eyebrow">{hero.eyebrow}</div>
  <h1>{hero.heading}</h1>
  <p>{hero.subhead}</p>
  <div class="coord-strip" aria-hidden="true">
    {hero.micro.map((m) => <span>{m}</span>)}
  </div>
</section>

<section class="founder-section">
  <div class="communities-grid">
    {list.map((item) => (
      <div class="community-card">
        <div class="community-card-top">
          <span class="meta muted">{item.kind}</span>
          <span class="pill"><span class="dot"></span><span>{activeLabel}</span></span>
        </div>
        <h3>{item.name}</h3>
        <p class="community-tagline">{item.tagline}</p>
        <p class="muted">{item.body}</p>
        <div class="coord-strip" aria-hidden="true">
          {item.tags.map((t) => <span>{t}</span>)}
        </div>
        <div class="community-card-actions">
          <a class="btn hoverable" href={localePath(lang, `/${item.slug}`)}>{viewLabel} <ArrowIcon dir="right" /></a>
          {item.links.map((link) => (
            <a class="btn hoverable" href={link.href} target="_blank" rel="noopener">{link.label} <ArrowIcon dir="up-right" /></a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="founder-section center">
  <div class="meta muted eyebrow">{intro.eyebrow}</div>
  <h2>{intro.heading}</h2>
  {intro.body.map((p) => <p>{p}</p>)}
</section>

<section class="founders-closing">
  <h2>{closing.heading}</h2>
  <p>{closing.supporting}</p>
  <div class="hero-actions">
    <a class="btn hoverable" href="https://www.instagram.com/lattitudecoffee" target="_blank" rel="noopener">{closing.ctaInstagram} <ArrowIcon dir="up-right" /></a>
  </div>
</section>
