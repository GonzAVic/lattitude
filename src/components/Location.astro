---
import ArrowIcon from "./ArrowIcon.astro";
import { location, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = location[lang];
---

<section class="location" id="location">
  <div class="location-grid">
    <div>
      <div class="meta muted" style="margin-bottom:20px">{t.eyebrow}</div>
      <h2>{t.heading}</h2>
    </div>
    <div class="location-card">
      <div class="location-row"><span class="meta muted">{t.addressLabel}</span><strong>{t.address}</strong></div>
      <div class="location-row"><span class="meta muted">{t.hoursLabel}</span><strong>{t.hoursWeekday}<br>{t.hoursSaturday}</strong></div>
      <div class="location-row"><span class="meta muted">{t.instagramLabel}</span><strong>@lattitudecoffee</strong></div>
      <div class="location-actions">
        <a class="btn hoverable" href="https://maps.app.goo.gl/Z8L3mJFAC32dR3XL7" target="_blank" rel="noopener">{t.googleMaps} <ArrowIcon dir="up-right" /></a>
        <a class="btn hoverable" href="https://www.instagram.com/lattitudecoffee" target="_blank" rel="noopener">{t.instagram} <ArrowIcon dir="up-right" /></a>
      </div>
    </div>
  </div>

  <div class="coordinate-display">
    <span class="crosshair"><i></i></span>
    <div>
      <div class="meta muted">{t.coordEyebrow}</div>
      <div class="coord-big">21°01'11.6"N &nbsp; 89°34'16.2"W</div>
    </div>
    <span class="star"><i></i></span>
  </div>
</section>
