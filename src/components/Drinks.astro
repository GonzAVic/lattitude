---
import DrinkFeature from "./DrinkFeature.astro";
import { drinksSection, drinksList, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = drinksSection[lang];
const drinks = drinksList[lang];
---

<section class="drinks" id="drinks">
  <div class="drinks-top">
    <div>
      <div class="meta muted" style="margin-bottom:18px">{t.eyebrow}</div>
      <h2>{t.heading}</h2>
    </div>
    <p>{t.body}</p>
  </div>

  <DrinkFeature drinks={drinks} />
</section>
