---
import DrinkFeature from "./DrinkFeature.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { drinksSection, drinksList, localePath, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = drinksSection[lang];
const drinks = drinksList[lang];
---

<section class="drinks" id="drinks">
  <div class="drinks-top">
    <div>
      <div class="meta muted" style="margin-bottom:18px">{t.eyebrow}</div>
      <h2>{t.heading}</h2>
    </div>
    <p>{t.body}</p>
  </div>

  <DrinkFeature drinks={drinks} />

  <div class="hero-actions" style="margin-top:48px">
    <a class="btn hoverable" href={localePath(lang, "/menu/")}>{t.menuCta} <ArrowIcon dir="right" /></a>
  </div>
</section>
