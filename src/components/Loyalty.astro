---
import ArrowIcon from "./ArrowIcon.astro";
import { loyalty, localePath, type Locale } from "../i18n/content";
import { sampleState, bustSvg } from "../scripts/peeps";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = loyalty[lang];
const c = t.card;
const f = t.signup;
const al = t.album;

// Visitors see the card as a PREVIEW (2026-10-23): empty stamps, "Tu nombre", no QR —
// first-time visitors read the sample as their own card otherwise. A member's real card
// replaces all of it (script "lt-v2-sample" below).
const pv = t.preview;
const stamps = Array.from({ length: c.stampsTotal }, (_, i) => ({
  n: String(i + 1).padStart(2, "0"),
  filled: false,
  reward: i === c.stampsTotal - 1,
}));

// Avatar (Open Peeps via DiceBear): seeded from the holder's name, rendered at build
// time so the page paints with it; the editor in the sign-up form re-renders on change.
const a = t.avatar;
// Visitors get a random friendly avatar on every load (script below); this is the no-JS fallback.
const peep = sampleState(c.holder);
const bust = bustSvg(peep);

// Live card (2026-10-20): customers, stamps and notifications live in Lomu Studio
// (same card as lattitude-coffee.lomustudio.com/lealtad; the owner stamps from
// the Lomu portal). This page only talks to its API. PUBLIC_LOMU_API overrides
// the base URL and PUBLIC_LOMU_SLUG the business, for local testing.
const app = t.app;
const LOMU_API = (import.meta.env.PUBLIC_LOMU_API ?? "https://lomustudio.com").replace(/\/$/, "");
const LOMU_SLUG = import.meta.env.PUBLIC_LOMU_SLUG ?? "lattitude-coffee";
const apiBase = `${LOMU_API}/api/lealtad/${LOMU_SLUG}`;
const privacyUrl = `https://${LOMU_SLUG}.lomustudio.com/lealtad/privacidad${lang === "en" ? "?lang=en" : ""}`;
// Google review: the "Ask for reviews" link from Google Business Profile — opens the review form.
const reviewHref = "https://g.page/r/CXMPF8yzmwHbEBM/review";
---

<section class="lt-hero lt-v2-sample" data-lt-app data-api={apiBase} data-lang={lang} data-i18n={JSON.stringify(app)}>
  <!-- Returning member: start in a loading state so the sample card (someone else's
       avatar and name) never flashes before Lomu answers. Runs before first paint. -->
  <script is:inline>
    (function () {
      try {
        var h = document.currentScript.parentElement;
        if (localStorage.getItem("lattitude-card")) {
          h.classList.add("lt-loading");
          h.setAttribute("aria-busy", "true");
        } else {
          // No active card: a different random avatar on every load (painted by a script below).
          document.documentElement.dataset.ltSeed = Math.random().toString(36).slice(2);
          h.classList.add("lt-random-avatar");
        }
      } catch (e) {}
    })();
  </script>
  <div class="lt-hero-copy">
    <div class="meta muted">{t.eyebrow}</div>
    <h1>{t.heading}</h1>

    <!-- Outside the card wrap: its container-type would otherwise anchor this fixed toast. -->
    <p class="lt-toast" role="status" aria-live="polite" data-lt-toast data-stamp={t.celebrate.stamp} data-full={t.celebrate.full} hidden></p>

    <p class="lt-preview-note" data-lt-preview-note><strong>{pv.title}</strong> {pv.body}</p>
    <div class="lt-card-wrap" data-lt-flip>
      <div class="lt-flip">
        <!-- FRONT — stamps and progress -->
        <article class="lt-card lt-face lt-front" aria-label={c.label}>
          <div class="lt-card-top">
          <svg viewBox="680 425 556 225" role="img" aria-label="LATTITUDE°">
          <path d="M687.81,644.08V457.64h8.88v178.89h38.62v7.55H687.81z"/>
          <path d="M742.39,644.08l27.97-186.44h8.88l27.97,186.44h-8.88l-7.99-52.82h-31.07l-7.99,52.82H742.39z M774.63,475.19l-3.32,26.84l-10.72,81.68H789l-10.85-81.68l-3.18-26.84"/>
          <path d="M824.51,644.08V465.19h-22.64v-7.55h54.16v7.55h-22.64v178.89H824.51z"/>
          <path d="M885.76,644.08V465.19h-22.64v-7.55h54.16v7.55h-22.64v178.89H885.76z"/>
          <path d="M931.92,644.08V457.64h8.88v186.44H931.92z"/>
          <path d="M977.85,644.08V465.19h-22.64v-7.55h54.16v7.55h-22.64v178.89H977.85z"/>
          <path d="M1018.02,617.45v-159.8h8.88v161.13c0,14.65,7.55,20.42,18.2,20.42c10.65,0,18.2-5.77,18.2-20.42V457.64h8.88v159.8c0,18.64-9.32,29.3-27.08,29.3C1027.35,646.74,1018.02,636.09,1018.02,617.45z"/>
          <path d="M1083.94,457.64h24.86c17.76,0,27.08,9.77,27.08,29.3v127.84c0,19.53-9.32,29.3-27.08,29.3h-24.86V457.64z M1092.82,636.53h16.42c11.54,0,17.76-7.1,17.76-20.42V485.61c0-13.76-6.22-20.42-17.76-20.42h-16.42V636.53z"/>
          <path d="M1148.52,644.08V457.64h47.5v7.55h-38.62v81.68h31.96v7.55h-31.96v82.12h38.62v7.55H1148.52z"/>
          <path d="M1220.49,453.44c-1.97,0-3.77-0.47-5.39-1.42c-1.63-0.95-2.92-2.23-3.88-3.83c-0.96-1.61-1.44-3.38-1.44-5.32c0-1.97,0.48-3.75,1.44-5.34c0.96-1.59,2.26-2.87,3.88-3.82c1.63-0.95,3.43-1.42,5.39-1.42c1.99,0,3.79,0.47,5.41,1.42c1.62,0.95,2.91,2.22,3.87,3.82c0.96,1.59,1.44,3.37,1.44,5.34c0,1.94-0.48,3.72-1.44,5.32c-0.96,1.61-2.25,2.88-3.87,3.83C1224.28,452.97,1222.48,453.44,1220.49,453.44z M1220.49,449.71c1.26,0,2.4-0.31,3.43-0.93c1.02-0.62,1.84-1.45,2.45-2.48c0.61-1.03,0.91-2.18,0.91-3.44c0-1.26-0.31-2.41-0.91-3.44c-0.61-1.03-1.42-1.86-2.45-2.48c-1.02-0.62-2.17-0.93-3.43-0.93c-1.26,0-2.4,0.31-3.43,0.93c-1.02,0.62-1.84,1.45-2.45,2.48c-0.61,1.03-0.91,2.18-0.91,3.44c0,1.26,0.3,2.41,0.91,3.44c0.61,1.03,1.42,1.86,2.45,2.48C1218.09,449.4,1219.23,449.71,1220.49,449.71z"/>
          </svg>
          <span class="lt-card-label" data-lt-card-label data-active={c.label}>{pv.label}</span>
          </div>

          <div class="lt-card-body">
            <div class="lt-card-left">
              <span class="lt-avatar" data-peep-bust data-cta={pv.avatarCta} set:html={bust} />
              <span class="lt-mono lt-muted lt-level-name" data-lt-level-name>{pv.level}</span>
              <strong class="lt-holder" data-lt-holder>{pv.holder}</strong>
            </div>

            <div class="lt-card-right">
              <ol class="lt-stamps" data-lt-stamps data-stamp-label={c.stampLabel} data-reward-label={c.rewardLabel}>
                {stamps.map((s) => (
                  <li class:list={["lt-stamp", { filled: s.filled, reward: s.reward }]} title={s.reward ? c.rewardLabel : `${c.stampLabel} ${s.n}`}>
                    {s.reward ? (
                      <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M10.5 16h15v8.5a6.5 6.5 0 0 1-6.5 6.5h-2a6.5 6.5 0 0 1-6.5-6.5z" /><path d="M25.5 18.5h2.25a3.25 3.25 0 0 1 0 6.5H25.5" /><path d="M8.5 34.5h20" /><path d="M15 6.5c-1.6 1.7 1.6 3.3 0 5M20.5 6.5c-1.6 1.7 1.6 3.3 0 5" /></svg>
                    ) : s.filled ? (
                      <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="10" fill="none" /><path d="M20 4v32M4 20h32" /><circle class="dot" cx="20" cy="20" r="2.6" /></svg>
                    ) : (
                      <span>{s.n}</span>
                    )}
                  </li>
                ))}
              </ol>
              <div class="lt-legend lt-mono lt-muted">
                <span><i class="lt-key filled"></i>{c.stampLabel}</span>
                <span><i class="lt-key reward"></i><span data-lt-total>{c.stampsTotal}</span> = {c.rewardLabel}</span>
              </div>
            </div>
          </div>

          <div class="lt-card-foot">
            <div class="ruler"></div>
          </div>
        </article>

        <!-- BACK — avatar, name and the QR the counter scans, with the code as backup text -->
        <article class="lt-card lt-face lt-back" aria-label={c.codeLabel} aria-hidden="true" inert>
          <div class="lt-card-top">
          <svg viewBox="680 425 556 225" role="img" aria-label="LATTITUDE°">
          <path d="M687.81,644.08V457.64h8.88v178.89h38.62v7.55H687.81z"/>
          <path d="M742.39,644.08l27.97-186.44h8.88l27.97,186.44h-8.88l-7.99-52.82h-31.07l-7.99,52.82H742.39z M774.63,475.19l-3.32,26.84l-10.72,81.68H789l-10.85-81.68l-3.18-26.84"/>
          <path d="M824.51,644.08V465.19h-22.64v-7.55h54.16v7.55h-22.64v178.89H824.51z"/>
          <path d="M885.76,644.08V465.19h-22.64v-7.55h54.16v7.55h-22.64v178.89H885.76z"/>
          <path d="M931.92,644.08V457.64h8.88v186.44H931.92z"/>
          <path d="M977.85,644.08V465.19h-22.64v-7.55h54.16v7.55h-22.64v178.89H977.85z"/>
          <path d="M1018.02,617.45v-159.8h8.88v161.13c0,14.65,7.55,20.42,18.2,20.42c10.65,0,18.2-5.77,18.2-20.42V457.64h8.88v159.8c0,18.64-9.32,29.3-27.08,29.3C1027.35,646.74,1018.02,636.09,1018.02,617.45z"/>
          <path d="M1083.94,457.64h24.86c17.76,0,27.08,9.77,27.08,29.3v127.84c0,19.53-9.32,29.3-27.08,29.3h-24.86V457.64z M1092.82,636.53h16.42c11.54,0,17.76-7.1,17.76-20.42V485.61c0-13.76-6.22-20.42-17.76-20.42h-16.42V636.53z"/>
          <path d="M1148.52,644.08V457.64h47.5v7.55h-38.62v81.68h31.96v7.55h-31.96v82.12h38.62v7.55H1148.52z"/>
          <path d="M1220.49,453.44c-1.97,0-3.77-0.47-5.39-1.42c-1.63-0.95-2.92-2.23-3.88-3.83c-0.96-1.61-1.44-3.38-1.44-5.32c0-1.97,0.48-3.75,1.44-5.34c0.96-1.59,2.26-2.87,3.88-3.82c1.63-0.95,3.43-1.42,5.39-1.42c1.99,0,3.79,0.47,5.41,1.42c1.62,0.95,2.91,2.22,3.87,3.82c0.96,1.59,1.44,3.37,1.44,5.34c0,1.94-0.48,3.72-1.44,5.32c-0.96,1.61-2.25,2.88-3.87,3.83C1224.28,452.97,1222.48,453.44,1220.49,453.44z M1220.49,449.71c1.26,0,2.4-0.31,3.43-0.93c1.02-0.62,1.84-1.45,2.45-2.48c0.61-1.03,0.91-2.18,0.91-3.44c0-1.26-0.31-2.41-0.91-3.44c-0.61-1.03-1.42-1.86-2.45-2.48c-1.02-0.62-2.17-0.93-3.43-0.93c-1.26,0-2.4,0.31-3.43,0.93c-1.02,0.62-1.84,1.45-2.45,2.48c-0.61,1.03-0.91,2.18-0.91,3.44c0,1.26,0.3,2.41,0.91,3.44c0.61,1.03,1.42,1.86,2.45,2.48C1218.09,449.4,1219.23,449.71,1220.49,449.71z"/>
          </svg>
          <span class="lt-card-label" data-lt-card-label data-active={c.label}>{pv.label}</span>
          </div>

          <!-- Three columns: avatar · QR (same size, aligned) · texts. -->
          <div class="lt-back-body">
            <span class="lt-avatar lt-back-avatar" data-peep-bust set:html={bust} />
            <!-- QR the counter scans (Lomu's card.qr for members; a sample here). -->
            <span class="lt-qr lt-qr-placeholder" data-lt-qr role="img" aria-label={pv.qr}><span>{pv.qr}</span></span>
            <div class="lt-back-info">
              <span class="lt-mono lt-muted">{c.holderLabel}</span>
              <strong class="lt-back-name" data-lt-holder>{pv.holder}</strong>
              <span class="lt-mono lt-muted lt-back-code-label">{c.codeLabel}</span>
              <span class="lt-mono lt-code" data-lt-code>{pv.code}</span>
            </div>
          </div>

          <div class="lt-card-foot">
            <div class="ruler"></div>
          </div>
        </article>
      </div>

      <!-- Members only: level and what's left for the next one (Lomu, 2026-10-21). -->
      <p class="lt-level" data-lt-level hidden><span class="lt-level-line" data-lt-level-line></span></p>

      <button class="lt-flip-btn hoverable" type="button" aria-pressed="false" data-front={c.flipToBack} data-back={c.flipToFront}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.7M20 4v4.7h-4.7M20 12a8 8 0 0 1-13.7 5.6L4 15.3M4 20v-4.7h4.7" /></svg>
        <span>{c.flipToBack}</span>
      </button>
    </div>

    <div class="hero-actions" style="justify-content:flex-start">
      <a class="btn hoverable" href="#registro" data-lt-join-cta>{t.ctaJoin} <ArrowIcon dir="down" /></a>
      <a class="btn hoverable" href="#encontrar" data-lt-join-cta>{app.heroFind} <ArrowIcon dir="down" /></a>
      <a class="btn hoverable" href={localePath(lang, "/menu/")} data-lt-join-cta>{t.ctaMenu} <ArrowIcon dir="right" /></a>
      <!-- Members only: same share as the member panel (Story image of their avatar). -->
      <button class="btn hoverable" type="button" data-lt-hero-share hidden>{t.share.button} <ArrowIcon dir="up-right" /></button>
    </div>
    <!-- Members only (shown once their card loads): ask for a Google review. -->
    <div class="lt-review" data-lt-review hidden>
      <a data-track="review_clicked" data-track-source="loyalty_hero" class="btn hoverable" href={reviewHref} target="_blank" rel="noopener">{t.review.button} <ArrowIcon dir="up-right" /></a>
      <p>{t.review.text}</p>
    </div>
    <div class="coord-strip" aria-hidden="true">
      {t.micro.map((m) => <span>{m}</span>)}
    </div>
  </div>
  <!-- Stamp album (Lomu, 2026-10-26). Nothing shows until Lomu sends card.album; then the
       last stamp sits on the card's corner (script "album" below) and opens these. -->
  <dialog class="lt-album" data-lt-album aria-labelledby="lt-album-title" data-i18n={JSON.stringify(al)} data-lang={lang}>
    <div class="lt-album-inner">
      <header class="lt-album-head">
        <span class="lt-mono lt-muted" data-lt-album-eyebrow>{al.eyebrow}</span>
        <button class="lt-album-x" type="button" data-lt-album-close aria-label={al.close}>×</button>
      </header>
      <h2 id="lt-album-title" class="lt-album-title" data-lt-album-title></h2>
      <p class="lt-album-progress" data-lt-album-progress></p>
      <p class="lt-album-tried-line" data-lt-album-tried-line hidden></p>
      <p class="lt-album-note" data-lt-album-note role="status" aria-live="polite"></p>
      <button class="lt-album-packs" type="button" data-lt-album-open hidden>
        <span class="lt-album-packs-ico" aria-hidden="true"></span>
        <span class="lt-album-packs-txt"><strong data-lt-album-packs></strong><span>{al.packsSub}</span></span>
        <span class="lt-album-packs-go" aria-hidden="true">{al.packsGo}</span>
      </button>
      <div class="lt-album-next" data-lt-album-next hidden>
        <span class="lt-mono" data-lt-album-next-label></span>
        <div class="lt-album-bar" data-lt-album-bar aria-hidden="true"></div>
      </div>
      <ol class="lt-album-grid" data-lt-album-grid></ol>
      <div class="lt-album-reward" data-lt-album-reward hidden>
        <span class="lt-mono lt-muted">{al.reward}</span>
        <strong data-lt-album-reward-text></strong>
      </div>
      <details class="lt-album-how">
        <summary>{al.how}</summary>
        <ol data-lt-album-how></ol>
      </details>
    </div>
  </dialog>

  <dialog class="lt-album-zoom" data-lt-album-zoom aria-labelledby="lt-album-zoom-title">
    <button class="lt-album-x" type="button" data-lt-album-zoom-close aria-label={al.close}>×</button>
    <div class="lt-album-zoom-art" data-lt-album-zoom-art></div>
    <h3 id="lt-album-zoom-title" data-lt-album-zoom-title></h3>
    <p data-lt-album-zoom-tagline></p>
    <p class="lt-mono lt-album-zoom-coord" data-lt-album-zoom-coord hidden></p>
    <button class="lt-album-tried" type="button" data-lt-album-tried aria-pressed="false" hidden><span data-lt-album-tried-label></span></button>
    <p class="lt-album-tried-hint" data-lt-album-tried-hint role="status" aria-live="polite"></p>
  </dialog>

  <!-- "¿Qué pediste hoy?" (2026-10-27): asked when a visit stamp lands, with the owned, untried stamps. -->
  <dialog class="lt-ask" data-lt-ask aria-labelledby="lt-ask-title">
    <button class="lt-album-x" type="button" data-lt-ask-close aria-label={al.close}>×</button>
    <span class="lt-mono lt-muted">{al.askEyebrow}</span>
    <h2 id="lt-ask-title" data-lt-ask-title>{al.askTitle}</h2>
    <p data-lt-ask-sub>{al.askSub}</p>
    <ol class="lt-ask-grid" data-lt-ask-grid></ol>
    <button class="lt-ask-skip" type="button" data-lt-ask-skip>{al.askSkip}</button>
  </dialog>

  <dialog class="lt-pack" data-lt-pack aria-labelledby="lt-pack-title">
    <div class="lt-pack-stage">
      <button class="lt-pack-x" type="button" data-lt-pack-close aria-label={al.close}>×</button>
      <p class="lt-mono lt-pack-eyebrow" data-lt-pack-eyebrow>{al.pack}</p>
      <h2 id="lt-pack-title" class="lt-pack-title" data-lt-pack-title>{al.tapPack}</h2>
      <p class="lt-pack-sub" data-lt-pack-sub aria-live="polite"></p>
      <button class="lt-pack-env" type="button" data-lt-pack-env aria-label={al.openPack}>
        <svg viewBox="0 0 300 200" aria-hidden="true" class="lt-pack-env-body">
          <rect x="4" y="4" width="292" height="192" rx="10" fill="#efe7d8" stroke="#0a0a0a" stroke-width="3" />
          <path d="M4 196 L150 104 L296 196" fill="none" stroke="#0a0a0a" stroke-width="3" stroke-linejoin="round" />
        </svg>
        <svg viewBox="0 0 300 120" aria-hidden="true" class="lt-pack-env-flap">
          <path d="M4 4 L150 112 L296 4Z" fill="#e6dcc8" stroke="#0a0a0a" stroke-width="3" stroke-linejoin="round" />
        </svg>
        <span class="lt-pack-seal" aria-hidden="true">L°</span>
      </button>
      <div class="lt-pack-picks" data-lt-pack-picks></div>
      <div class="lt-pack-chosen" data-lt-pack-chosen hidden></div>
      <div class="lt-pack-actions">
        <button class="btn inverse" type="button" data-lt-pack-flipall hidden>{al.flipAll}</button>
        <button class="btn inverse" type="button" data-lt-pack-paste hidden>{al.paste}</button>
      </div>
    </div>
  </dialog>
</section>

<section class="founder-section lt-signup" id="registro">
  <div class="lt-signup-grid">
    <div data-lt-intro>
      <div data-lt-mode-show="new">
        <div class="meta muted eyebrow">{f.eyebrow}</div>
        <h2>{f.heading}</h2>
        <p>{f.body}</p>
      </div>
      <div data-lt-mode-show="find" hidden>
        <div class="meta muted eyebrow">{app.tabFind}</div>
        <h2>{app.findHeading}</h2>
        <p>{app.findIntro}</p>
      </div>
    </div>

    <!-- Shown instead of the sign-up once this browser has a card. -->
    <div class="lt-member" data-lt-member hidden>
      <div class="meta muted eyebrow">{app.memberEyebrow}</div>
      <h2 data-lt-member-heading></h2>
      <p data-lt-member-body></p>
      <div class="lt-member-actions">
        <a class="btn hoverable" href="#" data-lt-show-code>{app.showCode} <ArrowIcon dir="up" /></a>
        <!-- Hidden (2026-10-26): sharing lives in the hero button, which clicks this one. -->
        <button class="lt-chip hoverable" type="button" data-lt-share data-i18n={JSON.stringify(t.share)} hidden>{t.share.button}</button>
        <button class="lt-chip hoverable" type="button" data-lt-edit-avatar>{app.editAvatar}</button>
      </div>
      <p class="lt-note" data-lt-share-note role="status" hidden></p>
      <div class="lt-member-avatar" data-lt-avatar-slot hidden>
        <button class="btn hoverable" type="button" data-lt-save-avatar>{app.saveAvatar} <ArrowIcon dir="right" /></button>
        <p class="lt-note" data-lt-avatar-note hidden></p>
      </div>
      <button class="lt-link hoverable" type="button" data-lt-signout>{app.notMe}</button>
    </div>

    <div class="lt-signup-side" data-lt-signup>
    <!-- Two ways in, side by side: create a card or find yours. Switches in place (no reload). -->
    <div class="lt-seg" role="tablist" aria-label={app.findSummary}>
