<script>
  // Flip the loyalty card (UI only): button, tap, or a horizontal swipe.
  // The card keeps an accumulated angle so a swipe turns it in the swipe's direction.
  // The hidden face is made inert so keyboard/screen readers follow the visible one.
  import { track } from "../scripts/analytics";
  document.querySelectorAll<HTMLElement>("[data-lt-flip]").forEach((wrap) => {
    const flip = wrap.querySelector<HTMLElement>(".lt-flip")!;
    const btn = wrap.querySelector<HTMLButtonElement>(".lt-flip-btn")!;
    const label = btn.querySelector("span")!;
    const front = wrap.querySelector<HTMLElement>(".lt-front")!;
    const back = wrap.querySelector<HTMLElement>(".lt-back")!;
    let angle = 0;

    const turn = (dir: 1 | -1, method: "button" | "tap" | "swipe") => {
      angle += 180 * dir;
      flip.style.setProperty("--lt-rot", `${angle}deg`);
      const flipped = Math.abs(angle / 180) % 2 === 1;
      flip.classList.toggle("is-flipped", flipped);
      btn.setAttribute("aria-pressed", String(flipped));
      label.textContent = (flipped ? btn.dataset.back : btn.dataset.front) ?? "";
      front.inert = flipped;
      back.inert = !flipped;
      front.setAttribute("aria-hidden", String(flipped));
      back.setAttribute("aria-hidden", String(!flipped));
      if (flipped) track("loyalty_code_shown", { method });
    };

    btn.addEventListener("click", () => turn(1, "button"));

    // Swipe: horizontal drag of 40px+ that is clearly more horizontal than vertical.
    let startX = 0, startY = 0, tracking = false, swiped = false;
    flip.addEventListener("pointerdown", (e) => {
      tracking = true;
      swiped = false;
      startX = e.clientX;
      startY = e.clientY;
    });
    flip.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX, dy = e.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        swiped = true;
        turn(dx > 0 ? 1 : -1, "swipe");
      }
    });
    flip.addEventListener("pointercancel", () => (tracking = false));
    // A plain tap still flips; the click that follows a mouse drag is ignored.
    flip.addEventListener("click", () => {
      if (swiped) { swiped = false; return; }
      turn(1, "tap");
    });
  });
</script>

<script>
  // "Crear tarjeta" / "Ya tengo tarjeta": one segmented control swaps the form and the intro.
  // #encontrar (from the hero or a shared link) opens the find view directly.
  const seg = [...document.querySelectorAll<HTMLButtonElement>("[data-lt-mode]")];
  const setMode = (mode: string, focus = false) => {
    seg.forEach((b) => {
      const on = b.dataset.ltMode === mode;
      b.setAttribute("aria-selected", String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
    });
    document.querySelectorAll<HTMLElement>("[data-lt-mode-show]").forEach((el) => (el.hidden = el.dataset.ltModeShow !== mode));
  };
  seg.forEach((b, i) => {
    b.addEventListener("click", () => setMode(b.dataset.ltMode!));
    b.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const next = seg[(i + (e.key === "ArrowRight" ? 1 : seg.length - 1)) % seg.length];
      setMode(next.dataset.ltMode!, true);
    });
  });
  const fromHash = () => {
    if (location.hash === "#encontrar") {
      setMode("find");
      document.getElementById("registro")?.scrollIntoView({ behavior: "smooth" });
    } else if (location.hash === "#registro") setMode("new");
  };
  window.addEventListener("hashchange", fromHash);
  fromHash();
  // Clicking a link to the hash already in the URL fires no "hashchange" — and #encontrar isn't a
  // real anchor — so these buttons switch the view and scroll themselves, every time.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#encontrar"], a[href="#registro"]').forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      setMode(a.getAttribute("href") === "#encontrar" ? "find" : "new");
      document.getElementById("registro")?.scrollIntoView({ behavior: "smooth" });
      if (location.hash !== a.hash) history.pushState(null, "", a.hash);
    }),
  );
</script>

<script>
  // Avatar editor inside the sign-up form (UI only, state kept in this browser).
  // Until the visitor customises it, the avatar follows whatever they type as their name.
  // DiceBear loads only when the form is near.
  import { track as trackEvent } from "../scripts/analytics";
  const editor = document.querySelector<HTMLElement>("[data-peep-editor]");
  if (editor) {
    // Signup form or a member editing from their card panel.
    const editorContext = () => (editor.closest("[data-lt-avatar-slot]") ? "member" : "signup");
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const P = await import("../scripts/peeps");
      type State = import("../scripts/peeps").PeepState;
      const KEY = "lattitude-peep";
      const nameInput = document.querySelector<HTMLInputElement>("#lt-name");
      // No name typed yet → the same random sample avatar the card shows (data-seed set below).
      const fromName = (): State => {
        const name = nameInput?.value.trim();
        return name ? P.stateFromSeed(name) : P.sampleState(editor.dataset.seed ?? "");
      };

      let state: State = fromName();
      let customised = false;
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) ?? "null");
        if (saved && saved.head && saved.face) { state = saved; customised = true; }
      } catch {}
      let part: import("../scripts/peeps").PeepPart = "head";
      const optionsEl = editor.querySelector<HTMLElement>("#lt-options")!;
      const tabs = [...editor.querySelectorAll<HTMLButtonElement>(".lt-tab")];

      const paint = () => {
        const bust = P.bustSvg(state);
        document.querySelectorAll<HTMLElement>("[data-peep-bust]").forEach((el) => (el.innerHTML = bust));
        try { customised ? localStorage.setItem(KEY, JSON.stringify(state)) : localStorage.removeItem(KEY); } catch {}
      };

      const renderOptions = () => {
        optionsEl.setAttribute("aria-labelledby", `lt-tab-${part}`);
        optionsEl.innerHTML = "";
        for (const value of P.OPTIONS[part]) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "lt-opt hoverable";
          b.setAttribute("aria-pressed", String(state[part] === value));
          b.setAttribute("aria-label", value ?? optionsEl.dataset.none ?? "");
          b.innerHTML = value === null
            ? `<span class="lt-opt-none">${optionsEl.dataset.none}</span>`
            : P.headThumb({ ...state, [part]: value });
          b.addEventListener("click", () => {
            state = { ...state, [part]: value };
            customised = true;
            trackEvent("avatar_customized", { part, context: editorContext() });
            paint();
            optionsEl.querySelectorAll(".lt-opt").forEach((o) => o.setAttribute("aria-pressed", "false"));
            b.setAttribute("aria-pressed", "true");
          });
          optionsEl.appendChild(b);
        }
      };

      tabs.forEach((tab) =>
        tab.addEventListener("click", () => {
          part = tab.dataset.part as typeof part;
          tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
          renderOptions();
          optionsEl.scrollLeft = 0;
        }),
      );
      editor.querySelector("[data-peep-random]")!.addEventListener("click", () => {
        state = P.stateFromSeed(Math.random().toString(36).slice(2));
        customised = true;
        trackEvent("avatar_customized", { part: "random", context: editorContext() });
        paint();
        renderOptions();
      });
      editor.querySelector("[data-peep-reset]")!.addEventListener("click", () => {
        state = fromName();
        customised = false;
        paint();
        renderOptions();
      });
      nameInput?.addEventListener("input", () => {
        if (customised) return;
        state = fromName();
        paint();
        renderOptions();
      });

      paint();
      renderOptions();
    }, { rootMargin: "400px" });
    io.observe(editor);
  }
</script>

<script>
  import { track, resetMember } from "../scripts/analytics";
  // Live card (2026-10-20). Customers, stamps and notifications live in Lomu Studio;
  // this script only calls its loyalty API (data-api) and paints the card above.
  // The card token is kept in this browser; without it the page shows the sample card.
  const root = document.querySelector<HTMLElement>("[data-lt-app]");
  if (root) {
    const API = root.dataset.api!;
    const LANG = root.dataset.lang === "en" ? "en" : "es";
    const T = JSON.parse(root.dataset.i18n ?? "{}") as Record<string, string>;
    const TOKEN_KEY = "lattitude-card";
    const $ = <E extends Element = HTMLElement>(sel: string, el: ParentNode = document) => el.querySelector<E>(sel);
    const $$ = <E extends Element = HTMLElement>(sel: string, el: ParentNode = document) => [...el.querySelectorAll<E>(sel)];
    const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));

    type Avatar = { head: string; face: string; facialHair: string | null; accessories: string | null };
    type Level = { card: number; index: number; name: string; next: { name: string; cardsToGo: number } | null };
    // Lomu API (2026-10-21): `avatar` is what to draw (the member's own face, or the "lovingGrin1"
    // celebration face while mood === "reward"); `savedAvatar` is what they chose — the editor
    // starts from it, so the celebration face is never saved by accident.
    type Card = { token: string; name: string; code: string; stamps: number; stampsRequired: number; rewardReady: boolean; qr: string;
      avatar: Avatar | null; savedAvatar?: Avatar | null; mood?: "happy" | "reward"; level?: Level | null;
      album?: { ownedCount: number; triedCount?: number; complete: boolean; packs: unknown[] } | null };
    // The avatar editor (script above) keeps a customised avatar here; the card in
    // Lomu is the source of truth once the customer has one.
    const PEEP_KEY = "lattitude-peep";
    const savedPeep = (): Avatar | null => {
      try {
        const v = JSON.parse(localStorage.getItem(PEEP_KEY) ?? "null");
        return v && v.head && v.face ? v : null;
      } catch { return null; }
    };
    async function currentAvatar(name: string): Promise<Avatar> {
      const P = await import("../scripts/peeps");
      return savedPeep() ?? P.stateFromSeed(name);
    }
    type ApiResult = { ok: boolean; error?: string; card?: Card };

    const getToken = () => { try { return localStorage.getItem(TOKEN_KEY); } catch { return null; } };
    const setToken = (t: string | null) => { try { t ? localStorage.setItem(TOKEN_KEY, t) : localStorage.removeItem(TOKEN_KEY); } catch {} };

    async function api(path: string, opts: { method?: string; body?: unknown; token?: string | null } = {}): Promise<ApiResult & { status: number }> {
      try {
        const res = await fetch(`${API}/${path}`, {
          method: opts.method ?? "GET",
          headers: {
            ...(opts.body ? { "Content-Type": "application/json" } : {}),
            ...(opts.token ? { Authorization: `Bearer ${opts.token}` } : {}),
          },
          body: opts.body ? JSON.stringify({ ...(opts.body as object), lang: LANG }) : undefined,
        });
        const data = (await res.json().catch(() => ({ ok: false }))) as ApiResult;
        return { ...data, status: res.status };
      } catch {
        return { ok: false, error: T.errorGeneric, status: 0 };
      }
    }

    // --- Painting the card (same markup as the build-time sample) -------------
    const STAMP_SVG = '<svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="10" fill="none" /><path d="M20 4v32M4 20h32" /><circle class="dot" cx="20" cy="20" r="2.6" /></svg>';
    // Reward slot: a coffee cup, same line style as the stamps (2026-10-20).
    const REWARD_SVG = '<svg viewBox="0 0 40 40" aria-hidden="true"><path d="M10.5 16h15v8.5a6.5 6.5 0 0 1-6.5 6.5h-2a6.5 6.5 0 0 1-6.5-6.5z" /><path d="M25.5 18.5h2.25a3.25 3.25 0 0 1 0 6.5H25.5" /><path d="M8.5 34.5h20" /><path d="M15 6.5c-1.6 1.7 1.6 3.3 0 5M20.5 6.5c-1.6 1.7 1.6 3.3 0 5" /></svg>';

    function paintStamps(stamps: number, total: number) {
      const ol = $("[data-lt-stamps]");
      if (!ol) return;
      const stampLabel = ol.dataset.stampLabel ?? "";
      const rewardLabel = ol.dataset.rewardLabel ?? "";
      ol.innerHTML = Array.from({ length: total }, (_, i) => {
        const n = String(i + 1).padStart(2, "0");
        const filled = i < stamps;
        const reward = i === total - 1;
        const cls = ["lt-stamp", filled ? "filled" : "", reward ? "reward" : ""].filter(Boolean).join(" ");
        // The last slot is always the cup (black on white once earned).
        const inner = reward ? REWARD_SVG : filled ? STAMP_SVG : `<span>${n}</span>`;
        return `<li class="${cls}" title="${reward ? rewardLabel : `${stampLabel} ${n}`}">${inner}</li>`;
      }).join("");
      $$("[data-lt-total]").forEach((el) => (el.textContent = String(total)));
    }

    async function paintAvatar(card: Card) {
      // Draw `avatar` as Lomu sends it; keep `savedAvatar` (the member's choice) for the editor.
      // Without either it follows the name.
      const P = await import("../scripts/peeps");
      const chosen = card.savedAvatar ?? (card.mood === "reward" ? null : card.avatar);
      if (chosen) { try { localStorage.setItem(PEEP_KEY, JSON.stringify(chosen)); } catch {} }
      const bust = P.bustSvg(card.avatar ?? chosen ?? savedPeep() ?? P.stateFromSeed(card.name));
      $$("[data-peep-bust]").forEach((el) => (el.innerHTML = bust));
      // Full card, not yet redeemed: confetti behind the peep.
      $$(".lt-hero .lt-avatar").forEach((el) => el.classList.toggle("lt-avatar-reward", card.mood === "reward"));
    }

    function paintLevel(level: Level | null | undefined) {
      const box = $("[data-lt-level]");
      if (!level) { if (box) box.hidden = true; return; }
      $$("[data-lt-level-name]").forEach((el) => (el.textContent = level.name));
      $("[data-lt-level-line]")!.textContent = fill(T.levelLine, { name: level.name, card: level.card });
      if (box) box.hidden = false;
    }

    async function paintQr(card: Card) {
      // Lomu's own QR (the one its counter portal scans); without it, one made from the member code.
      const box = $("[data-lt-qr]");
      if (!box) return;
      if (card.qr && card.qr.includes("<svg")) {
        box.innerHTML = card.qr;
      } else if (card.code) {
        const { default: QR } = await import("qrcode");
        box.innerHTML = await QR.toString(card.code, { type: "svg", margin: 0, color: { dark: "#0a0a0a", light: "#f7f5f0" } });
      }
      const svg = box.querySelector("svg");
      if (svg) { svg.removeAttribute("width"); svg.removeAttribute("height"); svg.setAttribute("aria-hidden", "true"); }
      box.setAttribute("aria-label", `${box.getAttribute("aria-label")?.split(":")[0] ?? ""}: ${card.code}`);
    }

    function showMember(card: Card) {
      $$("[data-lt-holder]").forEach((el) => (el.textContent = card.name));
      $$("[data-lt-code]").forEach((el) => (el.textContent = card.code));
      paintStamps(card.stamps, card.stampsRequired);
      // The back shows the avatar and, under the name, the QR the counter scans.
      paintQr(card);
      paintAvatar(card);
      paintLevel(card.level);
      member = card;

      $("[data-lt-intro]")!.hidden = true;
      $("[data-lt-signup]")!.hidden = true;
      $("[data-lt-member]")!.hidden = false;
      $$("[data-lt-join-cta]").forEach((el) => el.setAttribute("hidden", ""));
      $("[data-lt-member-heading]")!.textContent = fill(T.memberHeading, { name: card.name.split(" ")[0] ?? card.name });
      $("[data-lt-member-body]")!.textContent = card.rewardReady
        ? T.memberReady
        : `${T.memberBody} ${fill(T.memberProgress, { stamps: card.stamps, total: card.stampsRequired })}.`;
      setupPush(card.token);
      // Hook (2026-10-20): lets the stamp-celebration script react to every painted card.
      root.dispatchEvent(new CustomEvent("lt:card", { detail: card }));
    }

    let member: Card | null = null;

    function signOut() {
      track("loyalty_signed_out", {}, { transport: "sendBeacon" });
      resetMember();
      setToken(null);
      try { localStorage.removeItem(PEEP_KEY); } catch {}
      location.reload();
    }

    // --- Sign-up, find by phone, sign-out --------------------------------------
    function showError(form: HTMLFormElement, msg: string | null) {
      const el = $("[data-lt-error]", form);
      if (!el) return;
      el.textContent = msg ?? "";
      el.hidden = !msg;
    }

    const form = $<HTMLFormElement>("[data-lt-form]");
    // Analytics: first field touched = sign-up started (once per page).
    form?.addEventListener("focusin", () => track("loyalty_signup_started"), { once: true });
    const failSignup = (reason: string, msg: string) => { track("loyalty_signup_failed", { reason }); return showError(form!, msg); };
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = String(fd.get("name") ?? "").trim();
      const phone = String(fd.get("phone") ?? "").replace(/\D/g, "");
      const email = String(fd.get("email") ?? "").trim();
      if (!name) return failSignup("name_missing", T.nameMissing);
      if (phone.length !== 10) return failSignup("phone_invalid", T.phoneInvalid);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return failSignup("email_invalid", T.emailInvalid);
      if (fd.get("consent") !== "1") return failSignup("consent_missing", T.consentMissing);
      showError(form, null);
      const btn = $<HTMLButtonElement>(".lt-submit", form)!;
      btn.disabled = true;
      const avatar = await currentAvatar(name);
      const r = await api("registro", {
        method: "POST",
        body: { name, phone, email, birthday: String(fd.get("birthday") ?? ""), consent: true, website: String(fd.get("website") ?? ""), avatar },
      });
      btn.disabled = false;
      if (!r.ok || !r.card) return failSignup(r.status ? `api_${r.status}` : "network", r.error ?? T.errorGeneric);
      setToken(r.card.token);
      showMember(r.card); // identifies the member (analytics) before the event below
      track("loyalty_signup_completed", { is_avatar_customized: !!savedPeep(), is_birthday_provided: !!fd.get("birthday") });
      root.scrollIntoView({ behavior: "smooth" });
    });

    const findForm = $<HTMLFormElement>("[data-lt-find-form]");
    findForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      // Members are matched by email (2026-10-20); Lomu's /buscar accepts { email }.
      const email = String(new FormData(findForm).get("email") ?? "").trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { track("loyalty_find_failed", { reason: "email_invalid" }); return showError(findForm, T.emailInvalid); }
      showError(findForm, null);
      const r = await api("buscar", { method: "POST", body: { email } });
      if (!r.ok || !r.card) { track("loyalty_find_failed", { reason: r.status ? `api_${r.status}` : "network" }); return showError(findForm, r.error ?? T.errorGeneric); }
      setToken(r.card.token);
      showMember(r.card);
      track("loyalty_card_found");
      root.scrollIntoView({ behavior: "smooth" });
    });

    $("[data-lt-signout]")?.addEventListener("click", signOut);

    // Edit the avatar with a card: the same editor moves into the member panel.
    $("[data-lt-edit-avatar]")?.addEventListener("click", async () => {
      const slot = $("[data-lt-avatar-slot]")!;
      const editor = $("[data-peep-editor]");
      if (member) {
        // Start from the member's own choice (never the celebration face); none yet → their name.
        const P = await import("../scripts/peeps");
        const start = member.savedAvatar ?? savedPeep() ?? P.stateFromSeed(member.name);
        try { localStorage.setItem(PEEP_KEY, JSON.stringify(start)); } catch {}
      }
      if (editor) {
        if (member) editor.dataset.seed = member.name; // "Reset" goes back to the member's name
        if (editor.parentElement !== slot) slot.prepend(editor);
      }
      slot.hidden = false;
      $("[data-lt-edit-avatar]")!.hidden = true;
    });
    $("[data-lt-save-avatar]")?.addEventListener("click", async () => {
      const note = $("[data-lt-avatar-note]")!;
      const token = getToken();
      if (!member || !token) return;
      const avatar = await currentAvatar(member.name);
      const r = await api("avatar", { method: "POST", body: avatar, token });
      note.textContent = r.ok ? T.avatarSaved : r.error ?? T.errorGeneric;
      if (r.ok) track("avatar_saved");
      note.hidden = false;
      if (r.ok && r.card) paintAvatar(r.card);
    });
    $("[data-lt-show-code]")?.addEventListener("click", (e) => {
      e.preventDefault();
      root.scrollIntoView({ behavior: "smooth" });
      const flip = $(".lt-flip");
      if (flip && !flip.classList.contains("is-flipped")) $<HTMLButtonElement>(".lt-flip-btn")?.click();
    });

    // --- Notifications (Web Push through Lomu; service worker on this domain) ---
    function setupPush(token: string) {
      // The "Avísame" button was removed from the member panel (2026-10-26): nothing to set up.
      const btn = $<HTMLButtonElement>("[data-lt-push]");
      const note = $("[data-lt-push-note]");
      if (!btn || !note) return;
      const say = (msg: string | null) => { note.textContent = msg ?? ""; note.hidden = !msg; };
      const supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;
      const ios = /iPhone|iPad|iPod/.test(navigator.userAgent);
      if (!supported) { if (ios) say(T.pushUnsupported); return; }

      const swUrl = `/lealtad/sw.js?api=${encodeURIComponent(API)}&t=${encodeURIComponent(token)}`;
      const register = async () => {
        const reg = await navigator.serviceWorker.register(swUrl, { scope: "/lealtad/" });
        if (reg.active) return reg;
        await new Promise<void>((ok) => {
          const w = reg.installing ?? reg.waiting;
          if (!w) return ok();
          w.addEventListener("statechange", () => { if (w.state === "activated") ok(); });
        });
        return reg;
      };
      const keyBytes = (k: string) => {
        const s = k.replace(/-/g, "+").replace(/_/g, "/");
        const b = atob(s + "===".slice((s.length + 3) % 4));
        return Uint8Array.from(b, (ch) => ch.charCodeAt(0));
      };
      const on = (sub: PushSubscription) => {
        btn.textContent = `${T.pushOn} · ${T.pushOff}`;
        btn.hidden = false;
        btn.onclick = async () => {
          const endpoint = sub.endpoint;
          await sub.unsubscribe().catch(() => {});
          await api("push/unsubscribe", { method: "POST", body: { endpoint }, token });
          track("push_disabled");
          off();
        };
      };
      const off = () => {
        btn.textContent = T.pushAsk;
        btn.hidden = false;
        btn.onclick = async () => {
          const perm = await Notification.requestPermission();
          if (perm !== "granted") { if (perm === "denied") say(T.pushDenied); return; }
          try {
            const prog = await fetch(`${API}/programa`).then((r) => r.json());
            if (!prog.pushKey) return say(T.errorGeneric);
            const reg = await register();
            const sub = (await reg.pushManager.getSubscription()) ?? (await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: keyBytes(prog.pushKey) }));
            const r = await api("push/subscribe", { method: "POST", body: sub.toJSON(), token });
            if (!r.ok) throw new Error("save");
            say(null);
            track("push_enabled");
            on(sub);
          } catch {
            say(T.errorGeneric);
          }
        };
      };
      if (Notification.permission === "denied") { say(T.pushDenied); return; }
      navigator.serviceWorker.getRegistration("/lealtad/").then(async (reg) => {
        const sub = reg ? await reg.pushManager.getSubscription() : null;
        sub ? on(sub) : off();
      }).catch(off);
    }

    // --- Start: a saved card is loaded fresh from Lomu ---------------------------
    const saved = getToken();
    if (saved) {
      api("tarjeta", { token: saved }).then((r) => {
        if (r.ok && r.card) showMember(r.card);
        else if (r.status === 401) setToken(null);
      });
    }

    // Hook (2026-10-20): "lt:refresh" re-reads the card from Lomu (the celebration script
    // asks while the code is on screen); it repaints only when stamps or reward changed.
    root.addEventListener("lt:refresh", async () => {
      const token = getToken();
      if (!token || !member) return;
      const r = await api("tarjeta", { token });
      if (!r.ok || !r.card) return;
      const changed = r.card.stamps !== member.stamps || r.card.rewardReady !== member.rewardReady || r.card.stampsRequired !== member.stampsRequired
        || r.card.mood !== member.mood || r.card.level?.card !== member.level?.card || r.card.level?.name !== member.level?.name
        || albumKey(r.card) !== albumKey(member);
      if (changed) showMember(r.card);
    });
    // The album script (2026-10-26) hands over the card Lomu returns after opening a pack.
    const albumKey = (c: Card) => (c.album ? `${c.album.ownedCount}/${c.album.packs?.length ?? 0}/${c.album.complete}/${c.album.triedCount ?? 0}` : "");
    root.addEventListener("lt:set-card", (e) => {
      const card = (e as CustomEvent<Card>).detail;
      if (card?.code && getToken()) showMember(card);
    });
  }
</script>

<script>
  // Stamp celebration (2026-10-20). Stamps are added by the staff in Lomu's portal, on
  // another device, so this page notices them three ways: comparing with the last count it
  // saw, asking Lomu every few seconds while the card is on screen, and when a push lands.
  import { track, identifyMember } from "../scripts/analytics";
  const app = document.querySelector<HTMLElement>("[data-lt-app]");
  if (app) {
    // Analytics: the loyalty page itself (Mixpanel's automatic page view covers the URL).
    let hasCard = false;
    try { hasCard = !!localStorage.getItem("lattitude-card"); } catch {}
    const internal = !!document.referrer && new URL(document.referrer).host === location.host;
    track("loyalty_page_viewed", { is_member: hasCard, entry: location.hash === "#encontrar" ? "find_link" : internal ? "internal" : document.referrer ? "external" : "direct" });

    const SEEN_KEY = "lattitude-card-seen";
    type Seen = { code: string; stamps: number; rewardReady: boolean; level?: string | null };
    type CardLike = Seen & { stampsRequired: number; name: string; avatar: Record<string, string | null> | null; level?: { name: string; card: number } | null };
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const toast = app.querySelector<HTMLElement>("[data-lt-toast]");
    let active = false;
    let timer: number | undefined;
    let confetti: { addConfetti: (o?: object) => Promise<void> } | null = null;

    const readSeen = (): Seen | null => { try { return JSON.parse(localStorage.getItem(SEEN_KEY) ?? "null"); } catch { return null; } };
    const writeSeen = (c: CardLike) => { try { localStorage.setItem(SEEN_KEY, JSON.stringify({ code: c.code, stamps: c.stamps, rewardReady: c.rewardReady, level: c.level?.name ?? null })); } catch {} };

    // The peep on the front reacts to the stamp: surprise, then a big smile, then back to
    // the member's own face. It's an overlay on top of the avatar — the saved avatar never
    // changes (not in this browser, not in Lomu).
    async function react(card: CardLike) {
      await new Promise((r) => setTimeout(r, 700)); // let the card's own avatar paint first
      const tile = app!.querySelector<HTMLElement>(".lt-front .lt-avatar");
      if (!tile) return;
      const P = await import("../scripts/peeps");
      let base: import("../scripts/peeps").PeepState;
      try {
        const saved = JSON.parse(localStorage.getItem("lattitude-peep") ?? "null");
        base = (card.avatar as any) ?? (saved?.head && saved?.face ? saved : P.stateFromSeed(card.name));
      } catch { base = P.stateFromSeed(card.name); }
      const happy = card.rewardReady ? "lovingGrin1" : "smileBig";

      tile.querySelector(".lt-avatar-fx")?.remove();
      const fx = document.createElement("span");
      fx.className = "lt-avatar-fx";
      fx.setAttribute("aria-hidden", "true");
      fx.innerHTML = P.bustSvg({ ...base, face: "awe" });
      tile.appendChild(fx);
      if (!reduceMotion) { tile.classList.remove("lt-avatar-bounce"); void tile.offsetWidth; tile.classList.add("lt-avatar-bounce"); }
      requestAnimationFrame(() => fx.classList.add("on"));

      await new Promise((r) => setTimeout(r, 650));
      fx.innerHTML = P.bustSvg({ ...base, face: happy });
      await new Promise((r) => setTimeout(r, card.rewardReady ? 3600 : 2000));
      fx.classList.remove("on");
      setTimeout(() => { fx.remove(); tile.classList.remove("lt-avatar-bounce"); }, reduceMotion ? 0 : 350);
    }

    async function celebrate(card: CardLike, gained: number) {
      // Show the stamps side so the new one is visible.
      const flip = app!.querySelector(".lt-flip");
      if (flip?.classList.contains("is-flipped")) app!.querySelector<HTMLButtonElement>(".lt-flip-btn")?.click();
      const items = [...app!.querySelectorAll(".lt-stamp")];
      for (let i = Math.max(0, card.stamps - gained); i < card.stamps; i++) items[i]?.classList.add("lt-stamp-new");

      if (toast) {
        toast.textContent = card.rewardReady
          ? toast.dataset.full ?? ""
          : (toast.dataset.stamp ?? "").replace("{stamps}", String(card.stamps)).replace("{total}", String(card.stampsRequired));
        toast.hidden = false;
        setTimeout(() => (toast.hidden = true), 4500);
      }
      react(card);
      if (reduceMotion) return;
      if (!confetti) {
        const { default: JSConfetti } = await import("js-confetti");
        confetti = new JSConfetti();
      }
      // Monochrome, like the brand; a full card adds coffee.
      await confetti.addConfetti({ confettiColors: ["#0a0a0a", "#3a3a3a", "#737373", "#bdbdbd"], confettiNumber: card.rewardReady ? 260 : 150 });
      if (card.rewardReady) confetti.addConfetti({ emojis: ["☕"], emojiSize: 56, confettiNumber: 28 });
    }

    // Every card the page paints (load, sign-up, find, refresh) goes through here.
    // This tab compares with the last count IT saw; the stored count only covers the first
    // paint (stamps gained while the page was closed). So another open tab — or Lomu's own
    // page — can't "use up" this tab's celebration.
    let tabSeen: Seen | null = null;
    app.addEventListener("lt:card", (e) => {
      const card = (e as CustomEvent<CardLike>).detail;
      identifyMember(card);
      const detectedOn = tabSeen ? "live" : "page_load"; // live = while the page was open
      const prev = tabSeen ?? readSeen();
      if (prev && prev.code === card.code) {
        const gained = card.stamps - prev.stamps;
        const base = { stamps: card.stamps, stamps_required: card.stampsRequired, level: card.level?.name ?? null, card_number: card.level?.card ?? null, detected_on: detectedOn };
        if (gained > 0) track("stamp_received", { ...base, stamps_gained: gained });
        if (card.rewardReady && !prev.rewardReady) track("reward_ready", base);
        if (prev.level && card.level?.name && prev.level !== card.level.name) track("level_up", { from: prev.level, to: card.level.name, card_number: card.level.card, detected_on: detectedOn });
        if (gained > 0 || (card.rewardReady && !prev.rewardReady)) celebrate(card, Math.max(gained, 0));
      }
      tabSeen = { code: card.code, stamps: card.stamps, rewardReady: card.rewardReady, level: card.level?.name ?? null };
      writeSeen(card);
      active = true;
      schedule();
    });

    // How often to ask Lomu (the stamp comes from another device, there's no push to the page):
    // every 2.5 s for the first 3 min the code is on screen (customer at the counter), then 6 s;
    // every 20 s on the stamps side; never while the tab is hidden.
    const refresh = () => app.dispatchEvent(new Event("lt:refresh"));
    const flipEl = app.querySelector(".lt-flip");
    const showingCode = () => !!flipEl?.classList.contains("is-flipped");
    let codeSince = 0;
    function schedule() {
      clearTimeout(timer);
      if (!active || document.hidden) return;
      const wait = showingCode() ? (Date.now() - codeSince < 180000 ? 2500 : 6000) : 20000;
      timer = window.setTimeout(() => { refresh(); schedule(); }, wait);
    }
    // Any flip — button, tap or swipe — changes the pace; showing the code also checks right away.
    if (flipEl) new MutationObserver(() => {
      if (showingCode()) { codeSince = Date.now(); if (active) refresh(); }
      schedule();
    }).observe(flipEl, { attributes: true, attributeFilter: ["class"] });
    // Coming back to the page: tab shown again, window focused, page restored by Safari, back online.
    const wake = () => { if (!document.hidden && active) refresh(); schedule(); };
    document.addEventListener("visibilitychange", wake);
    window.addEventListener("focus", wake);
    window.addEventListener("online", wake);
    window.addEventListener("pageshow", (e) => { if ((e as PageTransitionEvent).persisted) wake(); });
    // A push from Lomu while the page is open (see public/lealtad/sw.js) also triggers a check.
    navigator.serviceWorker?.addEventListener("message", (e) => { if (e.data?.type === "lt:push" && active) refresh(); });
  }
</script>

<script>
  // Card loader (2026-10-20): ends once the member's card AND avatar are painted, when the
  // saved token turns out to be invalid (Lomu's script removes it), or after 8 s at most.
  const hero = document.querySelector<HTMLElement>("[data-lt-app].lt-loading");
  if (hero) {
    const done = () => {
      hero.classList.remove("lt-loading");
      hero.removeAttribute("aria-busy");
      clearTimeout(fallback);
      clearInterval(tokenWatch);
    };
    const fallback = window.setTimeout(done, 8000);
    const tokenWatch = window.setInterval(() => {
      try { if (!localStorage.getItem("lattitude-card")) done(); } catch { done(); }
    }, 300);
    hero.addEventListener("lt:card", () => {
      // The avatar is painted a moment after the card (async); wait for it, briefly.
      const avatar = hero.querySelector(".lt-avatar");
      if (!avatar) return done();
      const mo = new MutationObserver(() => { mo.disconnect(); done(); });
      mo.observe(avatar, { childList: true, subtree: true });
      setTimeout(() => { mo.disconnect(); done(); }, 2000);
    }, { once: true });
  }
</script>

<script>
  // "Compartir mi avatar" (2026-10-20): a 1080×1920 Story image drawn in the browser with the
  // member's avatar, first name and the brand — never the member code or QR.
  // Instagram can't be posted to from the web, so it goes through the phone's share sheet
  // (Web Share with a file); elsewhere the image downloads and the caption is copied.
  // iOS only opens the share sheet straight from the tap, so the image is prepared ahead
  // of time (when the card appears and whenever the avatar changes).
  import { track as trackShareEvent } from "../scripts/analytics";
  const trackShare = (method: string) => trackShareEvent("peep_shared", { method });
  const shareBtn = document.querySelector<HTMLButtonElement>("[data-lt-share]");
  const hostApp = document.querySelector<HTMLElement>("[data-lt-app]");
  if (shareBtn && hostApp) {
    const T = JSON.parse(shareBtn.dataset.i18n ?? "{}") as Record<string, string>;
    const note = document.querySelector<HTMLElement>("[data-lt-share-note]");
    const W = 1080, H = 1920, INK = "#f7f5f0", BG = "#0a0a0a", MUTED = "#8a8a8a";
    let file: File | null = null;
    let building: Promise<File | null> | null = null;

    const svgImage = (markup: string) => new Promise<HTMLImageElement>((ok, fail) => {
      const img = new Image();
      img.onload = () => ok(img);
      img.onerror = fail;
      img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(markup);
    });
    const withNs = (svg: Element) => {
      const c = svg.cloneNode(true) as Element;
      c.setAttribute("xmlns", "http://www.w3.org/2000/svg");
      return c;
    };

    async function build(): Promise<File | null> {
      const avatarSvg = hostApp!.querySelector(".lt-avatar > svg");
      const logoSvg = hostApp!.querySelector(".lt-card-top svg");
      if (!avatarSvg || !logoSvg) return null;
      const name = (hostApp!.querySelector("[data-lt-holder]")?.textContent ?? "").trim().split(/\s+/)[0] ?? "";
      await Promise.all([document.fonts.load("700 120px Inter"), document.fonts.load("400 44px Inter")]).catch(() => {});

      const logo = withNs(logoSvg);
      logo.setAttribute("fill", INK);
      const [avatarImg, logoImg] = await Promise.all([svgImage(withNs(avatarSvg).outerHTML), svgImage(logo.outerHTML)]);

      const c = document.createElement("canvas");
      c.width = W; c.height = H;
      const x = c.getContext("2d")!;
      x.fillStyle = BG; x.fillRect(0, 0, W, H);
      const mono = (size: number) => `500 ${size}px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace`;

      // header: logotype + eyebrow pill
      const lh = 64, lw = lh * (556 / 225);
      x.drawImage(logoImg, 96, 150, lw, lh);
      x.font = mono(30); x.textBaseline = "middle"; x.textAlign = "right";
      const eyebrow = T.eyebrow;
      (x as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = "4px"; // mono label tracking, where supported
      const ew = x.measureText(eyebrow).width;
      x.strokeStyle = INK; x.lineWidth = 3;
      x.beginPath(); x.roundRect(W - 96 - ew - 56, 145, ew + 56, 74, 37); x.stroke();
      x.fillStyle = INK; x.fillText(eyebrow, W - 96 - 28, 183);
      (x as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = "0px";
      x.fillStyle = "rgba(247,245,240,.2)"; x.fillRect(96, 290, W - 192, 2);

      // avatar tile (same rounded square as the card)
      const tile = 760, tx = (W - tile) / 2, ty = 400;
      x.fillStyle = INK;
      x.beginPath(); x.roundRect(tx, ty, tile, tile, 56); x.fill();
      x.save(); x.beginPath(); x.roundRect(tx, ty, tile, tile, 56); x.clip();
      x.drawImage(avatarImg, tx, ty, tile, tile);
      x.restore();

      // name + tagline
      x.textAlign = "center"; x.textBaseline = "alphabetic";
      x.fillStyle = INK; x.font = "700 132px Inter, Arial, sans-serif";
      x.fillText(name, W / 2, ty + tile + 190, W - 192);
      x.fillStyle = MUTED; x.font = "400 46px Inter, Arial, sans-serif";
      x.fillText(T.tagline, W / 2, ty + tile + 270, W - 192);

      // footer: handle, coordinates, ruler
      x.fillStyle = INK; x.font = mono(38);
      x.fillText("@LATTITUDECOFFEE", W / 2, H - 290);
      x.fillStyle = MUTED; x.font = mono(28);
      x.fillText("21°01′11.6″N / 89°34′16.2″W", W / 2, H - 230);
      x.fillStyle = "rgba(247,245,240,.35)";
      for (let i = 0, rx = 96; rx <= W - 96; i++, rx += 12) x.fillRect(rx, H - 160, 2, i % 4 === 0 ? 34 : 20);

      const blob = await new Promise<Blob | null>((ok) => c.toBlob(ok, "image/png"));
      return blob ? new File([blob], T.file, { type: "image/png" }) : null;
    }

    const prepare = () => {
      building = build().then((f) => (file = f)).catch(() => (file = null));
      return building;
    };

    // Prepare as soon as the member's card is painted, and again when the avatar changes.
    hostApp.addEventListener("lt:card", () => setTimeout(prepare, 600));
    const avatarEl = hostApp.querySelector(".lt-avatar");
    // Ignore the stamp reaction's temporary overlay (.lt-avatar-fx): the Story uses the real face.
    const isFx = (n: Node) => n instanceof Element && (n.classList.contains("lt-avatar-fx") || !!n.closest(".lt-avatar-fx"));
    if (avatarEl) new MutationObserver((ms) => {
      if (ms.every((m) => isFx(m.target) || [...m.addedNodes, ...m.removedNodes].every(isFx))) return;
      prepare();
    }).observe(avatarEl, { childList: true, subtree: true });

    const say = (msg: string) => { if (note) { note.textContent = msg; note.hidden = false; } };

    shareBtn.addEventListener("click", async () => {
      // Use the ready image so the share sheet opens inside the tap (iOS).
      const ready = file;
      if (ready && navigator.canShare?.({ files: [ready] })) {
        try { await navigator.share({ files: [ready], text: T.caption }); trackShare("share_sheet"); return; }
        catch (e) { if ((e as Error).name === "AbortError") return; }
      }
      // Fallback: download + copy caption.
      shareBtn.disabled = true;
      const label = shareBtn.textContent;
      shareBtn.textContent = T.preparing;
      const f = ready ?? (await (building ?? prepare()));
      shareBtn.disabled = false;
      shareBtn.textContent = label;
      if (!f) return;
      const a = document.createElement("a");
      a.href = URL.createObjectURL(f);
      a.download = f.name;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      try { await navigator.clipboard.writeText(T.caption); } catch {}
      say(T.saved);
      trackShare("download");
    });
  }
</script>

<script>
  // Show the review prompt to members only (people who have been here).
  const reviewHost = document.querySelector<HTMLElement>("[data-lt-app]");
  reviewHost?.addEventListener("lt:card", () => {
    const box = reviewHost.querySelector<HTMLElement>("[data-lt-review]");
    if (box) box.hidden = false;
    const share = reviewHost.querySelector<HTMLElement>("[data-lt-hero-share]");
    if (share) share.hidden = false;
  });
  // "Compartir mi avatar" in the hero: runs the member panel's share (synchronously, so the
  // tap still counts as the user gesture iOS needs to open the share sheet).
  reviewHost?.querySelector("[data-lt-hero-share]")?.addEventListener("click", () => {
    document.querySelector<HTMLButtonElement>("[data-lt-share]")?.click();
  });
</script>

<script>
  // No active card: paint a random friendly avatar (new on every load) on the sample card and
  // the sign-up preview, and start the editor from it. The avatar stays hidden until then.
  const seed = document.documentElement.dataset.ltSeed;
  const heroEl = document.querySelector<HTMLElement>("[data-lt-app]");
  if (seed && heroEl) {
    const editorEl = document.querySelector<HTMLElement>("[data-peep-editor]");
    if (editorEl) editorEl.dataset.seed = seed;
    import("../scripts/peeps").then((P) => {
      const bust = P.bustSvg(P.sampleState(seed));
      document.querySelectorAll<HTMLElement>("[data-peep-bust]").forEach((el) => (el.innerHTML = bust));
    }).finally(() => heroEl.classList.remove("lt-random-avatar"));
  }
</script>

<script>
  // Visitor preview: once a member's card is painted, drop the preview look
  // (label back to the real one, note hidden, avatar and QR at full strength).
  const pvHost = document.querySelector<HTMLElement>("[data-lt-app].lt-v2-sample");
  pvHost?.addEventListener("lt:card", () => {
    pvHost.classList.remove("lt-v2-sample");
    pvHost.querySelectorAll<HTMLElement>("[data-lt-card-label]").forEach((el) => (el.textContent = el.dataset.active ?? el.textContent));
    pvHost.querySelector<HTMLElement>("[data-lt-preview-note]")?.setAttribute("hidden", "");
  }, { once: true });
</script>

<script>
  // Stamp album (Lomu, 2026-10-26). Lomu decides everything (packs, options, which stamps
  // exist); this script only draws card.album and posts the choice. Stamps are never spent.
  // On the card there's ONE addition: the last stamp on the front's corner. No badge: its
  // lifted corner says "touch me", it wiggles on the first visits, and unopened packs peek
  // out from behind it.
  import { track } from "../scripts/analytics";

  // Pasaporte del menú (Lomu, 2026-10-27): owned stamps carry triedAt — the member's own
  // "I tried this drink" mark, set and cleared with album/probada. Shown as a postmark.
  type AlbumStamp = { id: string; title: string; corner?: string | null; footer?: string | null; tagline?: string | null; owned: boolean; svg: string;
    category?: string | null; coord?: string | null; triedAt?: string | null };
  type Album = {
    collection: { id: string; name: string; kind: "permanent" | "season"; endsOn?: string | null; series?: string | null; reward?: string | null };
    total: number; ownedCount: number; triedCount?: number; complete: boolean; every: number; nextPackIn: number | null;
    packs: { id: string; options: string[] }[];
    stamps: AlbumStamp[];
    last: { id: string; title: string; svg: string } | null;
    back: string;
  };
  type AlbumCard = { code: string; stamps?: number; album?: Album | null };

  const host = document.querySelector<HTMLElement>("[data-lt-app]");
  const sheet = document.querySelector<HTMLDialogElement>("[data-lt-album]");
  const front = host?.querySelector<HTMLElement>(".lt-front");
  if (host && sheet && front) {
    const T = JSON.parse(sheet.dataset.i18n ?? "{}") as Record<string, string> & { howSteps: string[] };
    const LANG = sheet.dataset.lang ?? "es";
    const API = host.dataset.api!;
    const $ = <E extends Element = HTMLElement>(sel: string) => document.querySelector<E>(sel)!;
    const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));
    const token = () => { try { return localStorage.getItem("lattitude-card"); } catch { return null; } };

    let album: Album | null = null;
    const byId = (id: string) => album?.stamps.find((s) => s.id === id);

    // Lomu's SVGs carry ids (perforation mask, clip, filter). The same stamp twice on the page
    // (corner + album) would share them and break, so every insertion gets its own suffix.
    // They come sanitized from Lomu; scripts, foreign content and on* handlers are dropped anyway.
    let uid = 0;
    function safeSvg(markup: string | null | undefined): string {
      if (!markup) return "";
      // Parsed like innerHTML would (lenient: a repeated attribute doesn't break it, unlike
      // strict XML); a <template> never runs scripts or loads anything while we clean it.
      const tpl = document.createElement("template");
      tpl.innerHTML = markup;
      const svg = tpl.content.firstElementChild;
      if (!svg || svg.nodeName.toLowerCase() !== "svg") return "";
      svg.querySelectorAll("script,foreignObject,iframe,object,embed").forEach((n) => n.remove());
      for (const el of [svg, ...svg.querySelectorAll("*")]) {
        for (const a of [...el.attributes]) {
          // Uploaded stamps (Lomu's "Subir timbre completo", 2026-10-27) arrive as an <image> pointing
          // at Lomu's WebP over https: allowed on <image> only, never on <a> or <use>.
          const v = a.value.trim();
          const okHref = /^(#|data:image\/(png|jpe?g|webp|gif);)/i.test(v) || (el.nodeName.toLowerCase() === "image" && /^https:\/\//i.test(v));
          if (/^on/i.test(a.name) || (/href$/i.test(a.name) && !okHref)) el.removeAttribute(a.name);
        }
      }
      svg.setAttribute("aria-hidden", "true");
      const k = `_lt${++uid}`;
      return svg.outerHTML.replace(/(\bid="|url\(#|href="#)([^")]+)/g, `$1$2${k}`);
    }

    // The stamps' lettering (Lomu's design): Barlow Condensed 600, loaded only once there's an album.
    let fontLoaded = false;
    function loadFont() {
      if (fontLoaded) return;
      fontLoaded = true;
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600&display=swap";
      document.head.append(link);
    }

    let confetti: { addConfetti: (o?: object) => Promise<unknown> } | null = null;
    async function burst(n = 140) {
      if (reduced) return;
      if (!confetti) { const { default: C } = await import("js-confetti"); confetti = new C(); }
      confetti.addConfetti({ confettiColors: ["#f7f5f0", "#bdbdbd", "#737373", "#e6dcc8"], confettiNumber: n });
    }

    // ---- The stamp on the card's corner ------------------------------------------------------
    const ENVELOPE = '<svg viewBox="0 0 60 40" aria-hidden="true"><rect x="1.5" y="1.5" width="57" height="37" rx="3" fill="#efe7d8" stroke="#0a0a0a" stroke-width="2"/><path d="M1.5 3 30 22 58.5 3" fill="none" stroke="#0a0a0a" stroke-width="2" stroke-linejoin="round"/><circle cx="30" cy="22" r="5.5" fill="#0a0a0a"/></svg>';
    const corner = document.createElement("button");
    corner.type = "button";
    corner.className = "lt-album-stamp hoverable";
    corner.hidden = true;
    corner.innerHTML = '<span class="lt-album-envs"></span><span class="lt-album-art"><span class="lt-album-paper"></span><span class="lt-album-flap"></span></span>';
    front.append(corner);
    // It lives inside the flipping card: the tap/swipe mustn't reach the flip.
    for (const ev of ["pointerdown", "pointerup", "click"]) corner.addEventListener(ev, (e) => e.stopPropagation());
    corner.addEventListener("mouseenter", () => document.body.classList.add("cursor-active"));
    corner.addEventListener("mouseleave", () => document.body.classList.remove("cursor-active"));
    corner.addEventListener("click", () => { stopHints(true); openAlbum("card_corner"); });
    corner.addEventListener("animationend", () => corner.classList.remove("hint", "nudge", "is-new"));
    const wiggle = (cls: string) => { corner.classList.remove("hint", "nudge"); void corner.offsetWidth; corner.classList.add(cls); };

    let envsShown = 0;
    function paintCorner(stuck?: string) {
      if (!album) return;
      const paper = corner.querySelector(".lt-album-paper")!;
      paper.innerHTML = album.last ? safeSvg(album.last.svg) : `<span class="lt-album-blank">${T.blank}</span>`;
      // up to 3 unopened packs peek out; a new one slides out from behind the stamp
      const n = Math.min(album.packs.length, 3);
      corner.querySelector(".lt-album-envs")!.innerHTML = Array.from({ length: n }, (_, i) =>
        `<span class="lt-album-env${i >= envsShown ? " in" : ""}">${ENVELOPE}</span>`).join("");
      envsShown = n;
      if (stuck && album.last?.id === stuck) wiggle("is-new");
      const packs = album.packs.length;
      corner.setAttribute("aria-label", fill(T.corner, { name: album.collection.name, owned: album.ownedCount, total: album.total })
        + (packs ? ` · ${packs === 1 ? T.cornerPack : fill(T.cornerPacks, { n: packs })}` : ""));
    }

    // First visits only: until the member taps it once (or after 3 visits) the corner lifts
    // every few seconds. Never with reduced motion, never while hidden or with the album open.
    const HINT_KEY = "lattitude-album-hint";
    let hint = { visits: 0, tapped: false };
    try { hint = { ...hint, ...JSON.parse(localStorage.getItem(HINT_KEY) ?? "{}") }; } catch {}
    const saveHint = () => { try { localStorage.setItem(HINT_KEY, JSON.stringify(hint)); } catch {} };
    let hintTimer: number | undefined;
    function startHints() {
      hint.visits++;
      saveHint();
      if (hint.tapped || hint.visits > 3 || reduced) return;
      const tick = () => { if (!document.hidden && !sheet!.open && !corner.matches(":hover") && !host!.querySelector(".lt-flip.is-flipped")) wiggle("hint"); };
      setTimeout(tick, 2500);
      hintTimer = window.setInterval(tick, 8000);
    }
    function stopHints(tapped = false) {
      clearInterval(hintTimer);
      if (tapped && !hint.tapped) { hint.tapped = true; saveHint(); }
    }

    // ---- The album sheet -------------------------------------------------------------------------
    const note = $("[data-lt-album-note]");
    function paintSheet(stuck?: string) {
      if (!album) return;
      const { collection: col, total, ownedCount, complete, every, nextPackIn, packs, stamps } = album;
      $("[data-lt-album-title]").textContent = col.name;
      let eyebrow = T.eyebrow;
      if (col.kind === "season" && col.endsOn) {
        const d = new Date(`${col.endsOn.slice(0, 10)}T12:00:00`);
        if (!isNaN(+d)) eyebrow = fill(T.season, { date: new Intl.DateTimeFormat(LANG, { day: "numeric", month: "short" }).format(d) });
      }
      $("[data-lt-album-eyebrow]").textContent = eyebrow;
      const left = total - ownedCount;
      const tried = album.triedCount ?? 0;
      $("[data-lt-album-progress]").innerHTML = `<strong>${fill(T.progress, { owned: ownedCount, total })}</strong>`
        + (complete ? ` · ${T.complete}`
          // Collections can be just for collecting (2026-10-26): no prize, no prize talk.
          : col.reward ? ` · ${left === 1 ? T.leftOne : fill(T.left, { n: left })}`
          : ` · ${left === 1 ? T.toGoOne : fill(T.toGo, { n: left })}`);

      // Second counter, always there once something is owned (Pokédex: seen / caught).
      const line = $("[data-lt-album-tried-line]");
      line.hidden = ownedCount === 0;
      const pending = ownedCount - tried;
      line.innerHTML = tried === 0 ? escapeHtml(T.triedNone)
        : `<strong>${fill(T.triedSome, { n: tried, owned: ownedCount })}</strong> · ${escapeHtml(pending > 0 ? fill(T.triedPending, { n: pending }) : T.triedAll)}`;

      const open = $<HTMLButtonElement>("[data-lt-album-open]");
      open.hidden = packs.length === 0;
      $("[data-lt-album-packs]").textContent = packs.length === 1 ? T.packsOne : fill(T.packs, { n: packs.length });

      // No packs: how many stamps to the next one.
      const next = $("[data-lt-album-next]");
      next.hidden = packs.length > 0 || complete || nextPackIn == null;
      if (!next.hidden && nextPackIn != null) {
        $("[data-lt-album-next-label]").textContent = nextPackIn === 1 ? T.nextOne : fill(T.next, { n: nextPackIn });
        const have = Math.max(0, every - nextPackIn);
        $("[data-lt-album-bar]").innerHTML = Array.from({ length: every }, (_, i) => `<i${i < have ? ' class="on"' : ""}></i>`).join("");
      }

      // Owned: in colour, tap to see it big. Missing: a dashed slot with its name.
      $("[data-lt-album-grid]").innerHTML = stamps.map((s) => s.owned
        ? `<li><button type="button" class="lt-album-slot owned${s.triedAt ? " tried" : " pending"}${stuck === s.id ? " is-new" : ""}" data-id="${s.id}" aria-label="${escapeAttr(s.triedAt ? `${s.title}, ${T.triedLabel}` : `${s.title}. ${T.triedAsk}`)}">${safeSvg(s.svg)}${s.triedAt ? postmark(s.triedAt) : ghostmark()}</button></li>`
        : `<li class="lt-album-slot missing" aria-label="${escapeAttr(`${T.missing}: ${s.title}`)}">${s.corner ? `<span class="lt-mono">${escapeHtml(s.corner)}</span>` : ""}<strong>${escapeHtml(s.title)}</strong></li>`).join("");

      const reward = $("[data-lt-album-reward]");
      reward.hidden = !col.reward;
      reward.classList.toggle("done", complete);
      $("[data-lt-album-reward-text]").textContent = complete ? T.rewardDone : col.reward ?? "";

      $("[data-lt-album-how]").innerHTML = [...T.howSteps.map((s) => fill(s, { every })), ...(col.reward ? [fill(T.howReward, { reward: col.reward })] : [])]
        .map((s) => `<li>${escapeHtml(s)}</li>`).join("");
    }
    // The "tried it" mark: a black-ink postmark (date in the ring, wavy cancel lines) over the stamp.
    const shortDate = (iso: string) => {
      const d = new Date(iso);
      return isNaN(+d) ? "" : new Intl.DateTimeFormat(LANG, { day: "numeric", month: "short" }).format(d).replace(".", "");
    };
    function postmark(iso: string, cls = "") {
      const d = new Date(iso);
      const day = shortDate(iso).toUpperCase();
      const year = isNaN(+d) ? "" : String(d.getFullYear());
      return `<svg class="lt-postmark${cls ? ` ${cls}` : ""}" viewBox="0 0 130 80" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round">`
        + `<circle cx="40" cy="40" r="34" stroke-width="2.6"/><circle cx="40" cy="40" r="27" stroke-width="1.2"/>`
        + `<path d="M80 22q7-6 14 0t14 0t14 0M80 34q7-6 14 0t14 0t14 0M80 46q7-6 14 0t14 0t14 0M80 58q7-6 14 0t14 0t14 0" stroke-width="2.6"/></g>`
        + `<g fill="currentColor" text-anchor="middle"><text x="40" y="29" font-family="ui-monospace,Menlo,monospace" font-size="7" letter-spacing=".8">LATTITUDE</text>`
        + `<text x="40" y="46" font-family="Inter,Arial,sans-serif" font-weight="800" font-size="13">${escapeHtml(day)}</text>`
        + `<text x="40" y="58" font-family="ui-monospace,Menlo,monospace" font-size="7.5" letter-spacing=".8">${year}</text></g></svg>`;
    }
    // Owned but untried (2026-10-27): the rubber stamp waits on the corner, off the drawing,
    // and now and then makes the stamping gesture. The postmark itself only lands once tried.
    function ghostmark() {
      return `<span class="lt-rubber" aria-hidden="true"><svg viewBox="0 0 60 70"><rect x="22" y="2" width="16" height="22" rx="8" fill="#b8865a" stroke="#0a0a0a" stroke-width="2.5"/>`
        + `<path d="M26 24h8v10h-8z" fill="#f7f5f0" stroke="#0a0a0a" stroke-width="2.5"/><rect x="8" y="34" width="44" height="14" rx="3" fill="#f7f5f0" stroke="#0a0a0a" stroke-width="2.5"/>`
        + `<rect x="5" y="48" width="50" height="10" rx="2" fill="#0a0a0a"/><path d="M14 64h32" stroke="#0a0a0a" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="3 4"/></svg></span>`;
    }
    const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const escapeAttr = escapeHtml;

    function openAlbum(source: string) {
      if (!album) return;
      note.textContent = "";
      paintSheet();
      sheet!.showModal();
      sheet!.scrollTop = 0;
      track("album_opened", { source, owned: album.ownedCount, total: album.total, packs: album.packs.length, collection: album.collection.id });
    }
    $("[data-lt-album-close]").addEventListener("click", () => sheet.close());
    sheet.addEventListener("click", (e) => { if (e.target === sheet) sheet.close(); }); // tap outside
    $("[data-lt-album-open]").addEventListener("click", () => openPack());

    // A stamp, big, with its tagline.
    const zoom = $<HTMLDialogElement>("[data-lt-album-zoom]");
    $("[data-lt-album-grid]").addEventListener("click", (e) => {
      const id = (e.target as Element).closest<HTMLElement>(".lt-album-slot.owned")?.dataset.id;
      const s = id ? byId(id) : undefined;
      if (!s) return;
      zoomId = s.id;
      $("[data-lt-album-tried-hint]").textContent = "";
      paintZoom(s);
      zoom.showModal();
    });
    let zoomId: string | null = null;
    const triedBtn = $<HTMLButtonElement>("[data-lt-album-tried]");
    function paintZoom(s: AlbumStamp, thud = false) {
      $("[data-lt-album-zoom-art]").innerHTML = safeSvg(s.svg) + (s.triedAt ? postmark(s.triedAt, thud && !reduced ? "thud" : "") : "");
      $("[data-lt-album-zoom-title]").textContent = s.title;
      const tag = $("[data-lt-album-zoom-tagline]");
      tag.textContent = s.tagline ?? "";
      tag.hidden = !s.tagline;
      const coord = $("[data-lt-album-zoom-coord]");
      coord.textContent = s.coord ?? "";
      coord.hidden = !s.coord;
      // Only stamps the member owns can be marked (Lomu refuses the rest anyway).
      triedBtn.hidden = !s.owned;
      triedBtn.setAttribute("aria-pressed", String(!!s.triedAt));
      $("[data-lt-album-tried-label]").textContent = s.triedAt ? fill(T.triedOn, { date: shortDate(s.triedAt) }) : T.triedAsk;
      triedBtn.title = s.triedAt ? T.triedUndo : T.tried;
    }
    // Marks or unmarks a drink in Lomu; on success the page repaints with Lomu's card.
    let marking = false;
    async function setTried(id: string, want: boolean): Promise<{ ok: boolean; error?: string }> {
      if (marking) return { ok: false };
      marking = true;
      const before = album?.triedCount ?? 0;
      let res: { ok?: boolean; error?: string; message?: string; card?: AlbumCard } = {};
      try {
        const r = await fetch(`${API}/album/probada`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token()}` },
          body: JSON.stringify({ id, tried: want, lang: LANG }),
        });
        res = await r.json().catch(() => ({}));
      } catch {}
      marking = false;
      if (!res.ok || !res.card?.code) return { ok: false, error: res.error ?? res.message ?? T.triedError };
      // Lomu's card repaints the page (lt:card updates `album` before any await).
      host.dispatchEvent(new CustomEvent("lt:set-card", { detail: res.card }));
      if (want) {
        try { navigator.vibrate?.(35); } catch {}
        if (before === 0) setTimeout(() => burst(90), 250); // the very first one gets confetti
      }
      track(want ? "album_stamp_tried" : "album_stamp_untried", { stamp: id, collection: album?.collection.id ?? "", tried: album?.triedCount ?? 0 });
      return { ok: true };
    }
    triedBtn.addEventListener("click", async () => {
      const s = zoomId ? byId(zoomId) : undefined;
      if (!s || marking) return;
      const want = !s.triedAt;
      const hint = $("[data-lt-album-tried-hint]");
      triedBtn.disabled = true;
      hint.textContent = T.saving;
      const r = await setTried(s.id, want);
      triedBtn.disabled = false;
      if (!r.ok) { hint.textContent = r.error ?? T.triedError; return; }
      const now = byId(s.id);
      if (now) paintZoom(now, want);
      hint.textContent = want ? T.triedUndo : "";
    });

    // ---- "¿Qué pediste hoy?" -------------------------------------------------------------------
    const ask = $<HTMLDialogElement>("[data-lt-ask]");
    const askGrid = $("[data-lt-ask-grid]");
    function showAsk(source: string) {
      if (!album || ask.open || sheet.open || zoom.open) return;
      const pendingStamps = album.stamps.filter((s) => s.owned && !s.triedAt);
      if (!pendingStamps.length) return;
      $("[data-lt-ask-title]").textContent = T.askTitle;
      $("[data-lt-ask-sub]").textContent = T.askSub;
      askGrid.innerHTML = pendingStamps.map((s) =>
        `<li><button type="button" class="lt-ask-pick" data-id="${s.id}" aria-label="${escapeAttr(s.title)}">${safeSvg(s.svg)}</button></li>`).join("");
      ask.showModal();
      track("album_ask_shown", { source, pending: pendingStamps.length });
    }
    askGrid.addEventListener("click", async (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>(".lt-ask-pick");
      if (!btn || btn.disabled || marking) return;
      askGrid.querySelectorAll<HTMLButtonElement>(".lt-ask-pick").forEach((b) => (b.disabled = true));
      const r = await setTried(btn.dataset.id!, true);
      if (!r.ok) {
        $("[data-lt-ask-sub]").textContent = r.error ?? T.triedError;
        askGrid.querySelectorAll<HTMLButtonElement>(".lt-ask-pick").forEach((b) => (b.disabled = false));
        return;
      }
      btn.insertAdjacentHTML("beforeend", postmark(new Date().toISOString(), reduced ? "" : "thud"));
      btn.classList.add("done");
      askGrid.querySelectorAll(".lt-ask-pick:not(.done)").forEach((b) => b.classList.add("fade"));
      $("[data-lt-ask-title]").textContent = T.askDone;
      $("[data-lt-ask-sub]").textContent = "";
      await wait(1400);
      ask.close();
    });
    $("[data-lt-ask-close]").addEventListener("click", () => ask.close());
    $("[data-lt-ask-skip]").addEventListener("click", () => { track("album_ask_skipped", {}); ask.close(); });
    ask.addEventListener("click", (e) => { if (e.target === ask) ask.close(); });

    $("[data-lt-album-zoom-close]").addEventListener("click", () => zoom.close());
    zoom.addEventListener("click", (e) => { if (e.target === zoom) zoom.close(); });

    // ---- Opening a pack ------------------------------------------------------------------------
    const pack = $<HTMLDialogElement>("[data-lt-pack]");
    const env = $<HTMLButtonElement>("[data-lt-pack-env]");
    const picks = $("[data-lt-pack-picks]");
    const chosenEl = $("[data-lt-pack-chosen]");
    const title = $("[data-lt-pack-title]"), sub = $("[data-lt-pack-sub]"), eyebrow = $("[data-lt-pack-eyebrow]");
    const flipAll = $<HTMLButtonElement>("[data-lt-pack-flipall]"), paste = $<HTMLButtonElement>("[data-lt-pack-paste]");
    let current: { id: string; options: string[] } | null = null;
    let chosen: string | null = null;
    let busy = false;
    let result: AlbumCard | null = null; // the card Lomu returns, applied on "Pegar"
    let failed = false;                  // 409 / gone: close and reload the card

    function openPack() {
      if (!album?.packs.length) return;
      current = album.packs[0];
      const options = current.options.filter((id) => byId(id));
      if (!options.length) return;
      chosen = null; result = null; failed = false; busy = false;
      env.className = "lt-pack-env"; env.hidden = false; env.disabled = false;
      picks.innerHTML = ""; picks.style.setProperty("--n", String(options.length));
      chosenEl.hidden = true; chosenEl.className = "lt-pack-chosen"; chosenEl.innerHTML = "";
      flipAll.hidden = true; paste.hidden = true;
      eyebrow.textContent = album.packs.length > 1 ? fill(T.packOf, { i: 1, n: album.packs.length }) : T.pack;
      title.textContent = T.tapPack;
      sub.textContent = "";
      pack.showModal();
      track("album_pack_opened", { collection: album.collection.id, options: options.length, packs: album.packs.length });
      if (reduced) tearOpen();
    }

    async function tearOpen() {
      if (!current || !album) return;
      env.disabled = true;
      if (!reduced) {
        env.classList.add("shake"); await wait(620);
        env.classList.add("cracked"); await wait(320);
        env.classList.add("open"); await wait(520);
        env.classList.add("gone"); await wait(420);
      }
      env.hidden = true;
      const options = current.options.filter((id) => byId(id));
      picks.innerHTML = options.map((id, i) => {
        const s = byId(id)!;
        return `<button type="button" class="lt-pack-pick${reduced ? " flipped" : ""}" data-id="${id}" style="animation-delay:${i * 120}ms" aria-label="${escapeAttr(reduced ? fill(T.pick, { title: s.title }) : T.faceDown)}">`
          + `<span class="lt-pack-pick-inner"><span class="lt-pack-face back">${safeSvg(album!.back)}</span><span class="lt-pack-face front">${safeSvg(s.svg)}</span></span></button>`;
      }).join("");
      requestAnimationFrame(() => picks.querySelectorAll(".lt-pack-pick").forEach((b) => b.classList.add("in")));
      if (reduced || options.length === 1) {
        if (options.length === 1 && !reduced) picks.querySelector(".lt-pack-pick")?.classList.add("flipped");
        promptChoice(options.length);
      } else {
        title.textContent = options.length === 2 ? T.two : T.three;
        sub.textContent = T.flipHint;
        flipAll.hidden = false;
      }
    }

    function promptChoice(n: number) {
      flipAll.hidden = true;
      title.textContent = n === 1 ? T.last : T.choose;
      sub.textContent = n === 1 ? T.lastSub : T.chooseSub;
    }

    function flip(btn: HTMLButtonElement) {
      const s = byId(btn.dataset.id!);
      btn.classList.add("flipped");
      if (s) btn.setAttribute("aria-label", fill(T.pick, { title: s.title }));
      const all = [...picks.querySelectorAll(".lt-pack-pick")];
      if (all.every((b) => b.classList.contains("flipped"))) promptChoice(all.length);
    }

    async function choose(btn: HTMLButtonElement) {
      if (busy || chosen || !current || !album) return;
      busy = true;
      const id = btn.dataset.id!;
      const s = byId(id)!;
      const all = [...picks.querySelectorAll<HTMLButtonElement>(".lt-pack-pick")];
      all.forEach((b) => { if (b !== btn) b.classList.add("fade"); b.disabled = true; });
      sub.textContent = T.saving;

      // Lomu keeps the pack and its options; the choice only counts once it says ok.
      let res: { ok?: boolean; message?: string; card?: AlbumCard } = {};
      let status = 0;
      try {
        const r = await fetch(`${API}/album/abrir`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token()}` },
          body: JSON.stringify({ pack: current.id, choice: id, lang: LANG }),
        });
        status = r.status;
        res = await r.json().catch(() => ({}));
      } catch {}

      if (!res.ok) {
        busy = false;
        if (status === 409 || status === 404) {
          // Already opened (another phone?) or gone: say so, then reload the card on close.
          failed = true;
          title.textContent = "";
          sub.textContent = res.message ?? T.error;
          picks.innerHTML = "";
          track("album_pack_failed", { status });
          return;
        }
        all.forEach((b) => { b.classList.remove("fade"); b.disabled = false; });
        sub.textContent = T.error;
        return;
      }

      chosen = id;
      result = res.card ?? null;
      await wait(380);
      picks.innerHTML = "";
      chosenEl.innerHTML = safeSvg(s.svg);
      chosenEl.hidden = false;
      chosenEl.classList.add("in");
      eyebrow.textContent = album.collection.name;
      title.textContent = s.title;
      sub.textContent = s.tagline ?? "";
      paste.hidden = false;
      paste.focus();
      track("album_stamp_chosen", { stamp: id, collection: album.collection.id, owned: album.ownedCount + 1, total: album.total });
      burst();
    }

    env.addEventListener("click", () => tearOpen());
    flipAll.addEventListener("click", () => picks.querySelectorAll<HTMLButtonElement>(".lt-pack-pick:not(.flipped)").forEach((b, i) => setTimeout(() => flip(b), reduced ? 0 : i * 140)));
    picks.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>(".lt-pack-pick");
      if (!btn || btn.disabled) return;
      btn.classList.contains("flipped") ? choose(btn) : flip(btn);
    });

    let stuck: string | null = null; // the stamp just pasted: lands with a small animation
    paste.addEventListener("click", () => {
      if (!chosen) return;
      stuck = chosen;
      pack.close();
      const s = byId(chosen);
      note.textContent = s ? fill(T.pasted, { title: s.title }) : "";
      // Repaint everything with Lomu's card (its lt:card brings us back to applyCard).
      if (result?.code) host.dispatchEvent(new CustomEvent("lt:set-card", { detail: result }));
      else host.dispatchEvent(new Event("lt:refresh"));
    });
    $("[data-lt-pack-close]").addEventListener("click", () => pack.close());
    pack.addEventListener("close", () => {
      if (failed) { failed = false; host.dispatchEvent(new Event("lt:refresh")); }
    });

    // ---- Every card the page paints --------------------------------------------------------------
    let seenStamps = -1;
    let asked = false;
    let seenPacks = -1;
    let seenComplete = false;
    host.addEventListener("lt:card", async (e) => {
      const card = (e as CustomEvent<AlbumCard>).detail;
      const next = card.album ?? null;
      if (!next) { album = null; corner.hidden = true; return; } // album off in Lomu: nothing
      const first = !album;
      const morePacks = seenPacks >= 0 && next.packs.length > seenPacks;
      const justCompleted = !first && next.complete && !seenComplete;
      album = next;
      seenPacks = next.packs.length;
      seenComplete = next.complete;
      loadFont();
      corner.hidden = false;

      const pasted = stuck;
      stuck = null;
      if (morePacks) {
        // New pack with a stamp: let the stamp celebration finish, then the pack peeks out.
        await wait(3600);
        paintCorner();
        wiggle("nudge");
      } else {
        paintCorner(pasted ?? undefined);
      }
      if (sheet.open) {
        paintSheet(pasted ?? undefined);
        if (pasted) sheet.querySelector(".lt-album-slot.is-new")?.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
      }
      if (justCompleted) {
        note.textContent = next.collection.reward ? T.done : T.complete;
        track("album_completed", { collection: next.collection.id, total: next.total });
        setTimeout(() => burst(260), 500);
      }
      // A visit stamp just landed (and no new pack to show): after the stamp celebration, ask
      // what they ordered. "?probar" in the URL opens it right away (to try the prototype).
      const stampsNow = card.stamps ?? -1;
      const newStamp = seenStamps >= 0 && stampsNow > seenStamps;
      seenStamps = stampsNow;
      if (newStamp && !morePacks) { await wait(3600); showAsk("visit_stamp"); }
      else if (first && !asked && new URLSearchParams(location.search).has("probar")) { asked = true; await wait(900); showAsk("url"); }
      if (first) startHints();
    });
  }
</script>
