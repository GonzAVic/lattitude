      <button class="lt-seg-btn hoverable" type="button" role="tab" id="lt-seg-find" aria-controls="lt-pane-find" aria-selected="false" tabindex="-1" data-lt-mode="find">{app.tabFind}</button>
    </div>

    <div id="lt-pane-new" role="tabpanel" aria-labelledby="lt-seg-new" data-lt-mode-show="new">
    <form class="lt-form" novalidate data-lt-form>
      <input class="lt-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="lt-field">
        <label for="lt-name"><span>{f.nameLabel}</span><span class="lt-req">{f.required}</span></label>
        <input id="lt-name" name="name" type="text" autocomplete="name" placeholder={f.namePlaceholder} required aria-describedby="lt-name-hint" />
        <small id="lt-name-hint">{f.nameHint}</small>
      </div>
      <fieldset class="lt-field lt-avatar-field" data-peep-editor data-seed={c.holder}>
        <legend><span>{a.label}</span><span class="lt-req">{a.hint}</span></legend>
        <div class="lt-avatar-row">
          <div class="lt-avatar-preview" data-peep-bust set:html={bust} />
          <div class="lt-avatar-actions">
            <button class="lt-chip hoverable" type="button" data-peep-random>{a.random}</button>
            <button class="lt-chip hoverable" type="button" data-peep-reset>{a.reset}</button>
          </div>
        </div>
        <div class="lt-tabs" role="tablist" aria-label={a.label}>
          {(["head", "face", "facialHair", "accessories"] as const).map((part, i) => (
            <button class="lt-tab hoverable" type="button" role="tab" id={`lt-tab-${part}`} aria-controls="lt-options" aria-selected={i === 0 ? "true" : "false"} data-part={part}>{a.parts[part]}</button>
          ))}
        </div>
        <div class="lt-options" id="lt-options" role="tabpanel" aria-labelledby="lt-tab-head" data-none={a.none}></div>
        <small>{a.credit}</small>
      </fieldset>
      <div class="lt-field">
        <label for="lt-phone"><span>{f.phoneLabel}</span><span class="lt-req">{f.required}</span></label>
        <div class="lt-phone">
          <span aria-hidden="true">+52</span>
          <input id="lt-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder={f.phonePlaceholder} required />
        </div>
      </div>
      <div class="lt-field">
        <label for="lt-email"><span>{f.emailLabel}</span><span class="lt-req">{f.required}</span></label>
        <input id="lt-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder={f.emailPlaceholder} required />
      </div>
      <div class="lt-field">
        <label for="lt-bday"><span>{f.birthdayLabel}</span><span class="lt-req muted">{f.optional}</span></label>
        <input id="lt-bday" name="birthday" type="date" autocomplete="bday" />
      </div>
      <label class="lt-consent">
        <input type="checkbox" name="consent" value="1" required />
        <span>{app.consent} <a class="hoverable" href={privacyUrl} target="_blank" rel="noopener">{f.privacyLink}</a></span>
      </label>
      <p class="lt-error" data-lt-error role="alert" hidden></p>
      <button class="btn hoverable lt-submit" type="submit">{f.submit} <ArrowIcon dir="right" /></button>
    </form>

    </div>

    <div id="lt-pane-find" role="tabpanel" aria-labelledby="lt-seg-find" data-lt-mode-show="find" hidden>
      <form class="lt-form" novalidate data-lt-find-form>
        <div class="lt-field">
          <label for="lt-find-email"><span>{f.emailLabel}</span><span class="lt-req">{f.required}</span></label>
          <input id="lt-find-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder={f.emailPlaceholder} required aria-describedby="lt-find-hint" />
          <small id="lt-find-hint">{app.findBody}</small>
        </div>
        <p class="lt-error" data-lt-error role="alert" hidden></p>
        <button class="btn hoverable lt-submit" type="submit">{app.findButton} <ArrowIcon dir="right" /></button>
