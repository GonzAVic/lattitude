---
import ArrowIcon from "./ArrowIcon.astro";
import { lab, labRows, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = lab[lang];
const rows = labRows[lang];
---

<section class="lab" style="display:none">
  <div class="lab-grid">
    <div>
      <div class="meta muted" style="margin-bottom:18px">{t.eyebrow}</div>
      <h2>{t.heading}</h2>
      <p class="lab-note">{t.note}</p>
    </div>
    <div class="lab-list">
      {rows.map((row) => (
        <div class="lab-row">
          <strong>{row.title}</strong>
          <div class="mini">
            <span class="meta muted">{row.tag}</span>
            {row.icon === "star" && <span class="star"><i></i></span>}
            {row.icon === "crosshair" && <span class="crosshair"><i></i></span>}
            {row.icon === "arrow" && <ArrowIcon dir="up-right" />}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
