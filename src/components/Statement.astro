---
import { statement, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = statement[lang];
---

<section class="statement" id="concept">
  <div class="statement-inner">
    <div class="meta muted" style="margin-bottom:24px">{t.eyebrow}</div>
    <h2>{t.heading}</h2>
    <p>{t.body}</p>

    <div class="statement-micro" aria-hidden="true">
      <strong class="micrographic-label">{t.micrographic}</strong>
      <img src="/micrographic-050.svg" alt="" />
    </div>
  </div>
</section>
