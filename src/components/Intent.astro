---
import { intent, intentStories, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = intent[lang];
const stories = intentStories[lang];
---

<section class="intent">
  <div class="section-head">
    <h3>{t.heading}</h3>
  </div>

  <div class="intent-grid">
    {stories.map((s) => (
      <article class="story">
        <div class="story-media">
          <img src={s.img} alt={s.alt} loading="lazy" />
          <div class="mmicro">
            <span class="mlabel meta">{s.label}</span>
            <div class="ruler"></div>
          </div>
        </div>
        <div class="story-copy">
          <h4>{s.title}</h4>
          <p>{s.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>
