---
import BaseLayout from "../layouts/BaseLayout.astro";
import RidePartner from "./RidePartner.astro";
import { rideSeo, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const seo = rideSeo[lang];
---

<BaseLayout lang={lang} path="/letsride" title={seo.title} description={seo.description} noindex>
  <RidePartner lang={lang} />
</BaseLayout>
