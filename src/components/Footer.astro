---
import { footer, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = footer[lang];
---

<footer>
  <div class="footer-grid">
    <div class="footer-logo">LATTI<br>TUDE°</div>
    <div class="footer-copy">{t.copy}</div>
    <div>
      <div class="footer-label meta">{t.exploreLabel}</div>
      <div class="footer-links"><a class="hoverable" href="#concept">{t.concept}</a><a class="hoverable" href="#drinks">{t.drinks}</a><a class="hoverable" href="#people">{t.people}</a><a class="hoverable" href="#location">{t.visit}</a></div>
    </div>
    <div>
      <div class="footer-label meta">{t.connectLabel}</div>
      <div class="footer-links"><a class="hoverable" href="https://www.instagram.com/lattitudecoffee" target="_blank" rel="noopener">{t.instagram}</a><a class="hoverable" href="https://maps.app.goo.gl/Z8L3mJFAC32dR3XL7" target="_blank" rel="noopener">{t.googleMaps}</a></div>
    </div>
  </div>

  <div class="footer-signal" aria-hidden="true"><span class="star"><i></i></span><div class="ruler"></div><span class="pill">{t.pill}</span></div>
  <div class="bottom"><span>© <span id="year"></span> LATTITUDE°</span><span>21°01'11.6"N / 89°34'16.2"W</span><span>{t.madeWith}</span></div>
</footer>
