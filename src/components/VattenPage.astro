---
import BaseLayout from "../layouts/BaseLayout.astro";
import VattenPartner from "./VattenPartner.astro";
import { vattenSeo, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const seo = vattenSeo[lang];
---

<BaseLayout lang={lang} path="/vatten" title={seo.title} description={seo.description}>
  <VattenPartner lang={lang} />
</BaseLayout>
