---
import ArrowIcon from "./ArrowIcon.astro";
import {
  foundersHero,
  foundersCommunity,
  foundersName,
  foundersOrigin,
  foundersIntention,
  foundersClosing,
  localePath,
  type Locale,
} from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const hero = foundersHero[lang];
const community = foundersCommunity[lang];
const name = foundersName[lang];
const origin = foundersOrigin[lang];
const intention = foundersIntention[lang];
const closing = foundersClosing[lang];

const menuHref = `${localePath(lang)}#drinks`;
const mapsHref = "https://maps.app.goo.gl/Z8L3mJFAC32dR3XL7";
---

<section class="founders-hero">
  <div class="meta muted eyebrow">{hero.eyebrow}</div>
  <h1>{hero.heading}</h1>
  <p>{hero.subhead}</p>
  <div class="coord-strip" aria-hidden="true">
    {hero.micro.map((m) => <span>{m}</span>)}
  </div>
</section>

<section class="founder-section center">
  <div class="meta muted eyebrow">{community.eyebrow}</div>
  <h2>{community.heading}</h2>
  {community.body.map((p) => <p>{p}</p>)}
  <div class="coord-strip" aria-hidden="true">
    {community.micro.map((m) => <span>{m}</span>)}
  </div>
</section>

<section class="founder-section center">
  <div class="meta muted eyebrow">{name.eyebrow}</div>
  <h2>{name.heading[0]}<br />{name.heading[1]}</h2>
  <p>{name.body}</p>
  <div class="coord-strip" aria-hidden="true">
    {name.micro.map((m) => <span>{m}</span>)}
  </div>
</section>

<section class="founder-section center">
  <div class="meta muted eyebrow">{origin.eyebrow}</div>
  <h2>{origin.heading}</h2>
  <p>{origin.body}</p>
  <div class="statement-micro" aria-hidden="true">
    <img src="/micrographic-about.svg" alt="" />
  </div>
</section>

<section class="founder-section">
  <div class="founder-media">
    <div class="founder-media-img">
      <img src={intention.img} alt={intention.alt} loading="lazy" />
    </div>
    <div class="founder-media-copy">
      <div class="meta muted eyebrow">{intention.eyebrow}</div>
      <h2>{intention.heading}</h2>
      {intention.body.map((p) => <p>{p}</p>)}
      <div class="coord-strip" aria-hidden="true">
        {intention.micro.map((m) => <span>{m}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="founders-closing">
  <h2>{closing.heading[0]}<br />{closing.heading[1]}</h2>
  <p>{closing.supporting}</p>
  <div class="hero-actions">
    <a class="btn hoverable" href={mapsHref} target="_blank" rel="noopener">{closing.ctaVisit} <ArrowIcon dir="up-right" /></a>
    <a class="btn hoverable" href={menuHref}>{closing.ctaMenu} <ArrowIcon dir="right" /></a>
  </div>
  <div class="coord-strip" aria-hidden="true">
    <span>{closing.eyebrow}</span>
    <span>21°01'11.6"N / 89°34'16.2"W</span>
  </div>
</section>
