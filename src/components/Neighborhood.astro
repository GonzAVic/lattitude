---
import { neighborhood, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = neighborhood[lang];
---

<section class="neighborhood" id="zona">
  <div class="neighborhood-grid">
    <div>
      <div class="meta muted" style="margin-bottom:20px">{t.eyebrow}</div>
      <h2>{t.heading}</h2>
    </div>
    <div class="neighborhood-copy">
      {t.body.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .neighborhood {
    padding: clamp(110px, 14vw, 210px) var(--pad);
    border-top: 1px solid var(--line);
  }
  .neighborhood-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 9vw;
    align-items: start;
  }
  .neighborhood h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 76px);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .neighborhood-copy {
    border-top: 1px solid #000;
    padding-top: 22px;
  }
  .neighborhood-copy p {
    margin: 0 0 20px;
    color: var(--secondary);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.55;
    letter-spacing: -0.02em;
  }
  .neighborhood-copy p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 950px) {
    .neighborhood-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
