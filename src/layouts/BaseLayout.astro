---
import "../styles/global.css";
import CursorRail from "../components/CursorRail.astro";
import NavOverlay from "../components/NavOverlay.astro";
import Footer from "../components/Footer.astro";
import { site, localePath, type Locale } from "../i18n/content";

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  /** Locale-agnostic page path, e.g. "/" for home or "/about" — used to build canonical + hreflang URLs. */
  path?: string;
  /** Unlisted pages: kept out of search engines. Still reachable by direct link. */
  noindex?: boolean;
}

const { lang, title, description, path = "/", noindex = false } = Astro.props;
const t = site[lang];
const pageTitle = title ?? t.title;
const pageDescription = description ?? t.description;

const canonicalURL = new URL(localePath(lang, path), Astro.site);
const enURL = new URL(localePath("en", path), Astro.site);
const esURL = new URL(localePath("es", path), Astro.site);
const ogImage = new URL(lang === "en" ? "/og-en.jpg" : "/og-es.jpg", Astro.site);
const ogLocale = lang === "en" ? "en_US" : "es_MX";
const ogLocaleAlt = lang === "en" ? "es_MX" : "en_US";

// Public contact number for Lattitude Coffee. Leave empty to omit `telephone` from the
// business JSON-LD; fill it (E.164, e.g. "+52 999 123 4567") to publish it.
const telephone = "+52 999 955 6212";
const mapsURL = "https://maps.app.goo.gl/Z8L3mJFAC32dR3XL7";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  "@id": new URL("/#business", Astro.site).toString(),
  "name": "Lattitude Coffee",
  "image": ogImage.toString(),
  "url": new URL(localePath("es"), Astro.site).toString(),
  "hasMap": mapsURL,
  ...(telephone ? { telephone } : {}),
  "servesCuisine": ["Coffee", "Café de especialidad", "Matcha", "Breakfast"],
  "priceRange": "$$",
  "currenciesAccepted": "MXN",
  "paymentAccepted": "Cash, Credit Card",
  "acceptsReservations": false,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle 16 A, Paraíso Maya, entre 15 A y 15 B",
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97134",
    "addressCountry": "MX",
  },
  "areaServed": {
    "@type": "City",
    "name": "Mérida",
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 21.019888,
    "longitude": -89.571167,
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "21:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "10:00",
      "closes": "18:00",
    },
  ],
  "sameAs": ["https://www.instagram.com/lattitudecoffee"],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script define:vars={{ lang, enPath: localePath("en", path) }}>
      (function () {
        try {
          var stored = localStorage.getItem("lattitude-lang");
          if (stored) return;
          // Only the default-locale (Spanish) page auto-redirects on first visit.
          // Any locale-specific URL (e.g. /en/, reached via a direct link, the
          // switcher, or a search engine) is respected as-is and never bounced.
          // Runs first, before any other tag, so a redirect aborts the page
          // before it requests fonts or other assets for the wrong locale.
          if (lang === "es") {
            var browserLang = (navigator.language || "es").slice(0, 2).toLowerCase();
            if (browserLang !== "es") {
              localStorage.setItem("lattitude-lang", "en");
              window.location.replace(enPath + window.location.hash);
              return;
            }
          }
          localStorage.setItem("lattitude-lang", lang);
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) — loaded after the locale redirect so a bounce
         never records a pageview for the wrong-locale URL. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YG6EXXY9SV"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-YG6EXXY9SV");
    </script>

    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lattitude Coffee" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{pageTitle}</title>
  </head>
  <body>
    <CursorRail />
    <NavOverlay lang={lang} path={path} />

    <main id="top">
      <slot />
    </main>

    <Footer lang={lang} />

    <script src="../scripts/main.js"></script>
  </body>
</html>
